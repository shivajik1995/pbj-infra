---
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
  { href: '/projects/', label: 'Projects' },
  { href: '/locations/', label: 'Locations' },
  { href: '/resources/', label: 'Resources' },
  { href: '/contact/#faq', label: 'FAQ' },
];
---
<header id="site-header" class="fixed top-0 left-0 right-0 z-[100] py-[22px] transition-[padding,background,backdrop-filter] duration-300 data-[scrolled=true]:py-3.5 data-[scrolled=true]:bg-paper/90 data-[scrolled=true]:backdrop-blur-md data-[scrolled=true]:border-b data-[scrolled=true]:border-ink/[.14]">
  <div class="wrap flex items-center justify-between">
    <a class="font-serif font-semibold text-xl -tracking-[0.01em]" href="/">PBJ <span class="text-accent">INFRA</span></a>
    <nav class="hidden md:flex gap-9 font-mono text-xs tracking-wide uppercase" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} class="relative pb-[3px] hover:text-accent transition-colors">{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-[18px]">
      <a href="/contact/" class="btn btn-line hidden md:inline-flex">Start Your Project →</a>
      <button id="menu-btn" class="flex md:hidden flex-col gap-[5px] w-[26px]" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="h-[1.5px] bg-ink block"></span>
        <span class="h-[1.5px] bg-ink block"></span>
        <span class="h-[1.5px] bg-ink block"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-nav" class="fixed inset-0 bg-ink text-paper z-[99] flex flex-col justify-center p-10 gap-6 -translate-y-full transition-transform duration-[400ms] [transition-timing-function:cubic-bezier(.16,1,.3,1)]" role="dialog" aria-modal="true" aria-label="Mobile navigation" hidden>
  {nav.map((item) => (
    <a href={item.href} class="font-serif text-3xl">{item.label}</a>
  ))}
  <a href="/contact/" class="font-serif text-3xl text-accent">Start Your Project →</a>
</div>

<script>
  const header = document.getElementById('site-header')!;
  const menuBtn = document.getElementById('menu-btn')!;
  const mobileNav = document.getElementById('mobile-nav')!;

  window.addEventListener('scroll', () => {
    header.dataset.scrolled = String(window.scrollY > 40);
  });

  function toggleNav(open: boolean) {
    mobileNav.hidden = !open;
    // allow the browser to paint hidden:false before animating in
    requestAnimationFrame(() => {
      mobileNav.style.transform = open ? 'translateY(0)' : 'translateY(-100%)';
    });
    menuBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  menuBtn.addEventListener('click', () => toggleNav(mobileNav.hidden));
  mobileNav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggleNav(false)));
</script>
