---
// Primary site navigation. The pill floats over every section on every page
// (dark hero/CTA and light content sections alike) — the inline script
// samples the resolved background behind the pill and flips to a
// light-glass/dark-text variant when it's light enough, so this keeps
// working regardless of a page's section order.
const nav: { href: string; label: string }[] = [
  { href: '/services/', label: 'Services' },
  { href: '/projects/', label: 'Projects' },
  { href: '/locations/', label: 'Locations' },
  { href: '/about/', label: 'About' },
  { href: '/resources/', label: 'Resources' },
  { href: '/contact/', label: 'Contact' },
];

// Published service pages, for the mobile "Services" sub-list.
const serviceLinks: { href: string; label: string }[] = [
  { href: '/services/swimming-pool-construction/', label: 'Swimming Pool Construction' },
  { href: '/services/pool-filtration-systems/', label: 'Pool Filtration Systems' },
  { href: '/services/swimming-pool-tiles/', label: 'Pool Tiling & Finishing' },
  { href: '/services/lagoon-pool-construction/', label: 'Lagoon Pool Construction' },
  { href: '/services/waterpark-construction/', label: 'Waterpark Construction' },
  { href: '/services/resort-construction/', label: 'Resort Construction' },
  { href: '/services/farmhouse-construction/', label: 'Farmhouse Construction' },
  { href: '/services/cob-house-construction/', label: 'Cob House Construction' },
  { href: '/services/ferro-concrete-design/', label: 'Ferro Concrete Design' },
  { href: '/services/ferrocement-dome/', label: 'Ferrocement Dome' },
  { href: '/services/land-development/', label: 'Land Development' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header id="site-header" class="fixed top-0 left-0 right-0 z-[100] px-4 pt-4 md:px-6 md:pt-5 transition-[padding] duration-300 data-[scrolled=true]:pt-2.5 data-[scrolled=true]:md:pt-3">
  <!-- Glass at every scroll position (not just on scroll) — this is chrome
       floating over the page, not a bar that becomes glass; it always has
       real content underneath it to frost. -->
  <div class="wrap !px-0">
    <div class="glass-strong rounded-full flex items-center gap-4 pl-6 pr-2.5 py-2.5 md:pl-7 md:pr-3 md:py-3 text-paper transition-[background,border-color] duration-300 data-[onlight=true]:!bg-paper/70 data-[onlight=true]:!border-ink/[.12] data-[onlight=true]:!text-ink" id="nav-pill">
      <a class="font-serif font-semibold text-lg md:text-xl -tracking-[0.01em] shrink-0" href="/">PBJ <span class="text-accent">INFRA</span></a>

      <nav aria-label="Primary" class="hidden lg:flex items-center gap-5 flex-1 justify-center">
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="font-mono text-[11px] tracking-[0.1em] uppercase opacity-75 hover:opacity-100 aria-[current=page]:opacity-100 aria-[current=page]:text-accent transition-opacity"
          >{item.label}</a>
        ))}
      </nav>

      <a
        href="/contact/"
        class="hidden lg:inline-flex items-center gap-2 shrink-0 rounded-full border border-current px-4 py-2 font-mono text-[11px] tracking-[0.1em] uppercase opacity-80 hover:opacity-100 hover:bg-accent hover:border-accent hover:text-paper transition-all"
        data-analytics-event="click_start_project"
        data-analytics-params={JSON.stringify({ placement: 'header' })}
      >Start a Project <span aria-hidden="true">→</span></a>

      <button id="menu-btn" class="flex lg:hidden flex-col gap-[5px] w-9 h-9 items-center justify-center rounded-full ml-auto shrink-0" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span class="h-[1.5px] w-[18px] bg-current block"></span>
        <span class="h-[1.5px] w-[18px] bg-current block"></span>
        <span class="h-[1.5px] w-[18px] bg-current block"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-nav" class="fixed inset-0 bg-ink/90 backdrop-blur-2xl [-webkit-backdrop-filter:blur(40px)] text-paper z-[99] flex flex-col p-10 pt-28 gap-2 overflow-y-auto -translate-y-full transition-transform duration-[400ms] [transition-timing-function:cubic-bezier(.16,1,.3,1)]" role="dialog" aria-modal="true" aria-label="Site navigation" hidden>
  {nav.map((item) => (
    <a
      href={item.href}
      aria-current={isActive(item.href) ? 'page' : undefined}
      class="font-serif text-3xl py-2 aria-[current=page]:text-accent"
    >{item.label}</a>
  ))}

  <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-paper/40 mt-6 mb-1">All services</span>
  <div class="flex flex-col gap-1.5">
    {serviceLinks.map((s) => (
      <a href={s.href} class="font-mono text-[12px] tracking-wide text-paper/70 hover:text-paper py-1">{s.label}</a>
    ))}
  </div>

  <a
    href="/contact/"
    class="btn btn-lt mt-8 self-start"
    data-analytics-event="click_start_project"
    data-analytics-params={JSON.stringify({ placement: 'mobile_nav' })}
  >Start a Project →</a>
</div>

<script>
  const header = document.getElementById('site-header')!;
  const pill = document.getElementById('nav-pill')!;
  const menuBtn = document.getElementById('menu-btn')!;
  const mobileNav = document.getElementById('mobile-nav')!;

  // The glass pill is fixed and floats over every section on every page —
  // dark (bg-ink) hero/CTA sections and light (bg-paper/bg-paper-dim)
  // content sections alike. Rather than hardcode section order per page,
  // sample the resolved background colour of whatever is actually behind
  // the pill and flip to a light-glass/dark-text variant when it's light
  // enough, so this keeps working if a page's section order changes.
  function updatePillContrast() {
    const rect = pill.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.bottom + 14;
    const el = document.elementFromPoint(x, y);
    let node: Element | null = el;
    let bg: string | null = null;
    while (node && node !== document.body) {
      const c = getComputedStyle(node).backgroundColor;
      if (c && c !== 'rgba(0, 0, 0, 0)' && c !== 'transparent') {
        bg = c;
        break;
      }
      node = node.parentElement;
    }
    if (!bg) bg = getComputedStyle(document.body).backgroundColor;
    const rgb = bg.match(/\d+/g)?.map(Number);
    if (!rgb || rgb.length < 3) return;
    const luminance = (0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]) / 255;
    pill.dataset.onlight = String(luminance > 0.6);
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    header.dataset.scrolled = String(window.scrollY > 40);
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(() => {
        updatePillContrast();
        ticking = false;
      });
    }
  });
  window.addEventListener('resize', updatePillContrast);
  updatePillContrast();

  function toggleNav(open: boolean) {
    mobileNav.hidden = !open;
    // allow the browser to paint hidden:false before animating in
    requestAnimationFrame(() => {
      mobileNav.style.transform = open ? 'translateY(0)' : 'translateY(-100%)';
    });
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';

    // The mobile nav is a translucent glass sheet (not solid), so the
    // fixed bottom WhatsApp/Get Quote bar would otherwise show through
    // it at reduced opacity instead of being cleanly hidden underneath.
    const stickyCta = document.getElementById('mobile-sticky-cta');
    if (stickyCta) {
      stickyCta.style.opacity = open ? '0' : '1';
      stickyCta.style.pointerEvents = open ? 'none' : '';
    }
  }

  menuBtn.addEventListener('click', () => toggleNav(mobileNav.hidden));
  mobileNav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggleNav(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileNav.hidden) toggleNav(false);
  });
</script>
