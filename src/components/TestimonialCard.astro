---
interface Props { author: string; context: string; quote: string }
const { author, context, quote } = Astro.props;
---
<div class="border border-ink/[.14] p-7 bg-paper">
  <p class="text-[14.5px] text-ink-soft mb-5 min-h-[96px]">"{quote}"</p>
  <div class="flex justify-between items-center font-mono text-[11px] text-ink/50 border-t border-ink/[.14] pt-3.5">
    <span>{author}</span>
    <span>{context}</span>
  </div>
</div>
