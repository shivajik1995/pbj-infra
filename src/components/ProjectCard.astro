---
interface Props {
  name: string;
  projectType: string;
  location: string;
  href: string | null;
  image: { src: string; alt: string; width: number; height: number };
}
const { name, projectType, location, href, image } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href ?? undefined} class="group block relative overflow-hidden text-paper">
  <div class="spec-frame aspect-[4/5]">
    <span class="cA"></span><span class="cB"></span>
    <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" class="w-full h-full object-cover brightness-[.72] group-hover:scale-105 transition-transform duration-700" />
    <span class="absolute top-[18px] right-[18px] font-mono text-[10px] tracking-wide uppercase border border-paper/50 px-2.5 py-1.5 z-[2]">{projectType}</span>
    {!href && <span class="absolute top-[18px] left-[18px] font-mono text-[10px] tracking-wide uppercase bg-ink/85 px-2.5 py-1.5 z-[2]">Case study in development</span>}
    <div class="absolute left-0 right-0 bottom-0 p-[22px] z-[2]">
      <h3 class="font-serif text-2xl mb-1 font-medium">{name}</h3>
      <span class="font-mono text-[11.5px] opacity-85">{location}</span>
      {href && <span class="block mt-2 font-mono text-xs tracking-wide uppercase opacity-90 group-hover:opacity-100">View Project →</span>}
    </div>
  </div>
</Tag>
