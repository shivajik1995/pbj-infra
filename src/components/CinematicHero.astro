---
// PBJ Infra — Cinematic Hero
//
// Design:
//   Architectural / cinematic / premium
//
// Technical:
//   - Astro static HTML
//   - GSAP only for enhancement
//   - No ScrollTrigger
//   - Native video playback
//   - Poster fallback
//   - Full HTML content available without JS
//   - Reduced-motion support
//   - Safe animation fallback

const posterSrc = 'https://pbjinfra.com/assets/images/resort.jpg';
---

<section
  class="hero-cinematic relative min-h-[100svh] overflow-hidden bg-ink text-paper"
  id="top"
  aria-labelledby="hero-title"
>
  <!-- =========================================================
       JS READY CONTRACT
  ========================================================== -->

  <script is:inline>
    (function (s) {
      if (s && s.parentElement) {
        s.parentElement.classList.add('js-ready');
      }
    })(document.currentScript);
  </script>


  <!-- =========================================================
       CINEMATIC VISUAL LAYER
  ========================================================== -->

  <div
    class="hero-visual absolute inset-0"
    aria-hidden="true"
  >

    <!-- Video -->
    <div class="hero-video-wrap absolute inset-[-3%]">

      <video
        class="hero-bg-video absolute inset-0 h-full w-full object-cover"
        src="/videos/hero-bg.mp4"
        poster={posterSrc}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      ></video>

    </div>


    <!-- Image / video grading -->

    <div
      class="absolute inset-0 bg-black/35"
    ></div>

    <div
      class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/30 to-black/5"
    ></div>

    <div
      class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-black/20"
    ></div>


    <!-- Accent atmospheric glow -->

    <div
      class="hero-atmosphere absolute inset-0"
    ></div>

  </div>


  <!-- =========================================================
       ARCHITECTURAL GRID
  ========================================================== -->

  <div
    class="hero-grid absolute inset-0 z-[1]"
    aria-hidden="true"
  ></div>


  <!-- =========================================================
       BLUEPRINT DRAWING
  ========================================================== -->

  <div
    class="hero-blueprint absolute inset-0 z-[2]"
    aria-hidden="true"
  >

    <svg
      class="absolute left-[5%] top-[14%] h-[72%] w-[90%]"
      viewBox="0 0 1400 760"
      fill="none"
      preserveAspectRatio="none"
    >

      <!-- Primary geometry -->

      <path
        class="blueprint-path"
        d="M70 610 L230 120 L690 55 L1230 170 L1300 600 L720 705 Z"
      />

      <path
        class="blueprint-path"
        d="M230 120 L720 705"
      />

      <path
        class="blueprint-path"
        d="M690 55 L720 705"
      />

      <path
        class="blueprint-path"
        d="M1230 170 L720 705"
      />

      <path
        class="blueprint-path"
        d="M70 610 L1300 600"
      />


      <!-- Secondary geometry -->

      <path
        class="blueprint-path blueprint-secondary"
        d="M280 505 L345 220 L790 175 L1050 265 L1010 490 Z"
      />

      <path
        class="blueprint-path blueprint-secondary"
        d="M345 220 L1010 490"
      />

      <path
        class="blueprint-path blueprint-secondary"
        d="M790 175 L280 505"
      />


      <!-- Dimension line -->

      <path
        class="blueprint-path blueprint-dimension"
        d="M230 92 H690"
      />

      <path
        class="blueprint-path blueprint-dimension"
        d="M215 82 V108"
      />

      <path
        class="blueprint-path blueprint-dimension"
        d="M705 82 V108"
      />


      <!-- Structural circles -->

      <circle
        class="blueprint-circle"
        cx="720"
        cy="375"
        r="125"
      />

      <circle
        class="blueprint-circle"
        cx="720"
        cy="375"
        r="82"
      />

    </svg>

  </div>


  <!-- =========================================================
       TECHNICAL CORNER MARKS
  ========================================================== -->

  <div
    class="hero-corner hero-corner-tl"
    aria-hidden="true"
  ></div>

  <div
    class="hero-corner hero-corner-br"
    aria-hidden="true"
  ></div>


  <!-- =========================================================
       TOP INFORMATION
  ========================================================== -->

  <div class="absolute inset-x-0 top-0 z-[5]">

    <div
      class="wrap flex items-start justify-between pt-28 md:pt-32"
    >

      <div class="hero-meta">

        <div class="font-mono text-[9px] uppercase tracking-[.22em] text-paper/55">
          PBJ INFRA
        </div>

        <div class="mt-2 font-mono text-[9px] uppercase tracking-[.16em] text-paper/35">
          Pune · Maharashtra
        </div>

      </div>


      <div class="hero-meta text-right">

        <div class="font-mono text-[9px] uppercase tracking-[.2em] text-paper/50">
          Design · Engineering · Build
        </div>

        <div class="mt-2 font-mono text-[9px] uppercase tracking-[.16em] text-paper/30">
          Since 2009
        </div>

      </div>

    </div>

  </div>


  <!-- =========================================================
       MAIN CONTENT
  ========================================================== -->

  <div
    class="wrap relative z-[5] flex min-h-[100svh] items-end pb-16 pt-40 md:pb-20"
  >

    <div class="hero-content w-full max-w-[1180px]">


      <!-- Eyebrow -->

      <div
        class="hero-eyebrow mb-6 flex items-center gap-3"
      >

        <span
          class="h-px w-9 bg-accent"
        ></span>

        <span
          class="font-mono text-[9px] uppercase tracking-[.2em] text-paper/65"
        >
          Built for the way you imagine it
        </span>

      </div>


      <!-- =====================================================
           H1
      ====================================================== -->

      <h1
        id="hero-title"
        class="hero-title max-w-[1100px] font-serif text-[clamp(48px,7.8vw,108px)] leading-[.86] tracking-[-.045em]"
      >

        <span class="mask-line block overflow-hidden">

          <span class="hero-title-line block">
            Whatever you imagine,
          </span>

        </span>


        <span class="mask-line block overflow-hidden">

          <span class="hero-title-line block text-paper/90">
            <span class="text-accent">we build it.</span>
          </span>

        </span>

      </h1>


      <!-- =====================================================
           LOWER CONTENT
      ====================================================== -->

      <div
        class="hero-lower mt-8 flex flex-col gap-7 md:mt-10 md:flex-row md:items-end md:justify-between"
      >


        <!-- Description -->

        <div class="max-w-[530px]">

          <p
            class="hero-description text-[14px] leading-[1.75] text-paper/65 md:text-[15px]"
          >
            Swimming pools, waterparks, resorts, farmhouses and specialised
            structures — designed, engineered and built by PBJ Infra, a
            Pune-based construction company operating since 2009.
          </p>


          <!-- Capability micro-strip -->

          <div
            class="hero-capabilities mt-5 flex flex-wrap gap-x-5 gap-y-2"
          >

            <span>POOLS</span>
            <span>WATERPARKS</span>
            <span>RESORTS</span>
            <span>SPECIALIZED STRUCTURES</span>

          </div>

        </div>


        <!-- ===================================================
             ACTIONS
        ==================================================== -->

        <div
          class="hero-actions flex flex-wrap gap-3"
        >

          <a
            href="/projects/"
            class="btn btn-solid hero-button"
            data-analytics-event="click_explore_work"
            data-analytics-params={JSON.stringify({ placement: 'hero' })}
          >
            Explore Our Work
            <span aria-hidden="true">→</span>
          </a>


          <a
            href="/contact/"
            class="btn btn-glass hero-button"
            data-analytics-event="click_start_project"
            data-analytics-params={JSON.stringify({ placement: 'hero' })}
          >
            Start a Project
            <span aria-hidden="true">↗</span>
          </a>

        </div>

      </div>


      <!-- =====================================================
           TRUST STRIP
      ====================================================== -->

      <div
        class="hero-trust mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-paper/[.16] pt-5"
      >

        <div class="flex items-center gap-2">

          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>

          <span class="font-mono text-[9px] uppercase tracking-[.15em] text-paper/50">
            Operating since 2009
          </span>

        </div>


        <div class="h-3 w-px bg-paper/15 hidden sm:block"></div>


        <div>

          <span class="font-mono text-[9px] uppercase tracking-[.15em] text-paper/50">
            Pune → India
          </span>

        </div>


        <div class="h-3 w-px bg-paper/15 hidden sm:block"></div>


        <div>

          <span class="font-mono text-[9px] uppercase tracking-[.15em] text-paper/50">
            Founder-led
          </span>

        </div>

      </div>

    </div>

  </div>


  <!-- =========================================================
       SCROLL INDICATOR
  ========================================================== -->

  <div
    class="hero-scroll absolute bottom-7 right-7 z-[5] hidden md:flex"
    aria-hidden="true"
  >

    <div class="flex items-center gap-3">

      <span class="font-mono text-[8px] uppercase tracking-[.2em] text-paper/35">
        Scroll
      </span>

      <span class="hero-scroll-line block h-12 w-px bg-paper/25"></span>

    </div>

  </div>


  <!-- =========================================================
       NO JS FALLBACK
  ========================================================== -->

  <noscript>

    <div class="absolute bottom-5 left-5 z-[10]">

      <span class="font-mono text-[9px] text-paper/50">
        PBJ INFRA · DESIGN / ENGINEERING / BUILD
      </span>

    </div>

  </noscript>

</section>


<style>

  /* ==========================================================
     BASE
  ========================================================== */

  .hero-cinematic {
    isolation: isolate;
  }


  /* ==========================================================
     VIDEO
  ========================================================== */

  .hero-video-wrap {
    will-change: transform;
  }

  .hero-bg-video {
    transform: scale(1.06);
    filter:
      saturate(.78)
      contrast(1.05)
      brightness(.88);

    will-change: transform;
  }


  /* ==========================================================
     ATMOSPHERE
  ========================================================== */

  .hero-atmosphere {
    background:
      radial-gradient(
        circle at 72% 42%,
        rgba(30,110,100,.20),
        transparent 32%
      ),
      radial-gradient(
        circle at 15% 85%,
        rgba(255,255,255,.04),
        transparent 28%
      );
  }


  /* ==========================================================
     GRID
  ========================================================== */

  .hero-grid {

    opacity: .07;

    background-image:
      linear-gradient(
        rgba(246,243,236,.28) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(246,243,236,.28) 1px,
        transparent 1px
      );

    background-size:
      80px 80px;

    mask-image:
      linear-gradient(
        to bottom,
        black 0%,
        rgba(0,0,0,.65) 55%,
        transparent 100%
      );
  }


  /* ==========================================================
     BLUEPRINT
  ========================================================== */

  .hero-blueprint {
    opacity: .65;
    pointer-events: none;
  }

  .blueprint-path,
  .blueprint-circle {

    vector-effect: non-scaling-stroke;

    stroke:
      rgba(246,243,236,.28);

    stroke-width: 1;

    fill: none;
  }

  .blueprint-secondary {

    stroke:
      rgba(30,110,100,.65);
  }

  .blueprint-dimension {

    stroke:
      rgba(246,243,236,.20);

    stroke-dasharray:
      4 8;
  }


  /* ==========================================================
     CORNER MARKS
  ========================================================== */

  .hero-corner {

    position: absolute;

    width: 45px;
    height: 45px;

    z-index: 3;

    opacity: .45;
  }

  .hero-corner::before,
  .hero-corner::after {

    content: '';

    position: absolute;

    background:
      rgba(246,243,236,.28);
  }

  .hero-corner::before {

    width: 45px;
    height: 1px;
  }

  .hero-corner::after {

    width: 1px;
    height: 45px;
  }

  .hero-corner-tl {

    top: 130px;
    left: 28px;
  }

  .hero-corner-br {

    right: 28px;
    bottom: 28px;
    transform: rotate(180deg);
  }


  /* ==========================================================
     TEXT
  ========================================================== */

  .mask-line {
    display: block;
    overflow: hidden;
  }

  .hero-title-line {

    will-change:
      transform;
  }

  .hero-capabilities {

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 8px;

    letter-spacing:
      .15em;

    color:
      rgba(246,243,236,.35);
  }

  .hero-capabilities span {

    position: relative;
  }

  .hero-capabilities span:not(:last-child)::after {

    content: '·';

    position: absolute;

    right: -13px;

    color:
      rgba(246,243,236,.20);
  }


  /* ==========================================================
     INITIAL MOTION STATE
  ========================================================== */

  @media (prefers-reduced-motion: no-preference) {

    .hero-cinematic.js-ready
      .hero-title-line {

      transform:
        translateY(115%);
    }

    .hero-cinematic.js-ready
      .hero-eyebrow,
    .hero-cinematic.js-ready
      .hero-description,
    .hero-cinematic.js-ready
      .hero-capabilities,
    .hero-cinematic.js-ready
      .hero-actions,
    .hero-cinematic.js-ready
      .hero-trust,
    .hero-cinematic.js-ready
      .hero-meta,
    .hero-cinematic.js-ready
      .hero-scroll {

      opacity: 0;
    }

  }


  /* ==========================================================
     BUTTON
  ========================================================== */

  .hero-button {

    transition:
      transform .45s cubic-bezier(.2,.7,.2,1),
      background-color .3s ease,
      color .3s ease;
  }

  .hero-button:hover {

    transform:
      translateY(-3px);
  }


  /* ==========================================================
     SCROLL
  ========================================================== */

  .hero-scroll-line {

    transform-origin:
      top;

    animation:
      heroScroll 2s ease-in-out infinite;
  }

  @keyframes heroScroll {

    0%,
    100% {
      transform:
        scaleY(.45);
      opacity: .3;
    }

    50% {
      transform:
        scaleY(1);
      opacity: .8;
    }

  }


  /* ==========================================================
     MOBILE
  ========================================================== */

  @media (max-width: 640px) {

    .hero-grid {

      background-size:
        55px 55px;
    }

    .hero-blueprint {

      opacity: .38;
    }

    .hero-bg-video {

      object-position:
        62% center;
    }

    .hero-corner {

      display: none;
    }

    .hero-capabilities {

      max-width: 340px;
    }

  }


  /* ==========================================================
     REDUCED MOTION
  ========================================================== */

  @media (prefers-reduced-motion: reduce) {

    .hero-title-line,
    .hero-bg-video {

      transform: none !important;
    }

    .hero-eyebrow,
    .hero-description,
    .hero-capabilities,
    .hero-actions,
    .hero-trust,
    .hero-meta,
    .hero-scroll {

      opacity: 1 !important;
    }

    .hero-scroll-line {

      animation: none !important;
    }

  }

</style>


<script>

  import { gsap } from 'gsap';


  const hero =
    document.querySelector<HTMLElement>(
      '.hero-cinematic'
    );


  if (hero) {

    /*
     * ========================================================
     * SAFETY FALLBACK
     * ========================================================
     */

    const clearEverything = () => {

      try {

        gsap.set(
          hero.querySelectorAll(
            '.hero-title-line, .hero-eyebrow, .hero-description, .hero-capabilities, .hero-actions, .hero-trust, .hero-meta, .hero-scroll'
          ),
          {
            clearProps:
              'all'
          }
        );

      } catch {

        hero.classList.remove(
          'js-ready'
        );

      }

    };


    const safetyTimer =
      window.setTimeout(
        clearEverything,
        4000
      );


    try {

      const reduceMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;


      const isDesktop =
        window.matchMedia(
          '(min-width: 900px)'
        ).matches;


      const canHover =
        window.matchMedia(
          '(hover: hover) and (pointer: fine)'
        ).matches;


      const video =
        hero.querySelector<HTMLVideoElement>(
          '.hero-bg-video'
        );


      const videoWrap =
        hero.querySelector<HTMLElement>(
          '.hero-video-wrap'
        );


      const blueprint =
        hero.querySelector<HTMLElement>(
          '.hero-blueprint'
        );


      const blueprintPaths =
        Array.from(
          hero.querySelectorAll<SVGGeometryElement>(
            '.blueprint-path, .blueprint-circle'
          )
        );


      const titleLines =
        Array.from(
          hero.querySelectorAll<HTMLElement>(
            '.hero-title-line'
          )
        );


      const eyebrow =
        hero.querySelector<HTMLElement>(
          '.hero-eyebrow'
        );


      const description =
        hero.querySelector<HTMLElement>(
          '.hero-description'
        );


      const capabilities =
        hero.querySelector<HTMLElement>(
          '.hero-capabilities'
        );


      const actions =
        hero.querySelector<HTMLElement>(
          '.hero-actions'
        );


      const trust =
        hero.querySelector<HTMLElement>(
          '.hero-trust'
        );


      const meta =
        Array.from(
          hero.querySelectorAll<HTMLElement>(
            '.hero-meta'
          )
        );


      const scroll =
        hero.querySelector<HTMLElement>(
          '.hero-scroll'
        );


      /* ======================================================
         REDUCED MOTION
      ====================================================== */

      if (reduceMotion) {

        video?.pause();

        window.clearTimeout(
          safetyTimer
        );

      } else {

        /* ====================================================
           BLUEPRINT DRAWING
        ==================================================== */

        blueprintPaths.forEach(
          (path) => {

            let length = 1200;

            try {

              if (
                typeof path.getTotalLength ===
                'function'
              ) {

                length =
                  path.getTotalLength();

              }

            } catch {}

            gsap.set(
              path,
              {
                strokeDasharray:
                  length,
                strokeDashoffset:
                  length,
                opacity:
                  0
              }
            );

          }
        );


        /* ====================================================
           INTRO TIMELINE
        ==================================================== */

        const intro =
          gsap.timeline({
            delay:
              .12,

            defaults: {
              ease:
                'power3.out'
            }
          });


        intro

          /* Metadata */

          .to(
            meta,
            {
              opacity:
                1,
              y:
                0,
              duration:
                .65,
              stagger:
                .08
            }
          )


          /* Blueprint */

          .to(
            blueprintPaths,
            {
              opacity:
                1,

              strokeDashoffset:
                0,

              duration:
                1.7,

              stagger:
                .025,

              ease:
                'power2.inOut'
            },
            '-=.35'
          )


          /* Video camera */

          .to(
            video,
            {
              scale:
                1,

              duration:
                2.1,

              ease:
                'power2.out'
            },
            '-=1.25'
          )


          /* H1 */

          .to(
            titleLines,
            {
              y:
                0,

              duration:
                1.0,

              stagger:
                .12,

              ease:
                'power4.out'
            },
            '-=1.05'
          )


          /* Eyebrow */

          .to(
            eyebrow,
            {
              opacity:
                1,

              y:
                0,

              duration:
                .55
            },
            '-=.55'
          )


          /* Description */

          .to(
            description,
            {
              opacity:
                1,

              y:
                0,

              duration:
                .6
            },
            '-=.35'
          )


          /* Capabilities */

          .to(
            capabilities,
            {
              opacity:
                1,

              y:
                0,

              duration:
                .5
            },
            '-=.35'
          )


          /* Actions */

          .to(
            actions,
            {
              opacity:
                1,

              y:
                0,

              duration:
                .6
            },
            '-=.35'
          )


          /* Trust */

          .to(
            trust,
            {
              opacity:
                1,

              y:
                0,

              duration:
                .55
            },
            '-=.3'
          )


          /* Scroll */

          .to(
            scroll,
            {
              opacity:
                1,

              duration:
                .45
            },
            '-=.2'
          );


        /* ====================================================
           MOUSE DEPTH
        ==================================================== */

        if (
          canHover &&
          isDesktop &&
          videoWrap &&
          blueprint
        ) {

          const moveX =
            gsap.quickTo(
              videoWrap,
              'x',
              {
                duration:
                  .7,
                ease:
                  'power3.out'
              }
            );


          const moveY =
            gsap.quickTo(
              videoWrap,
              'y',
              {
                duration:
                  .7,
                ease:
                  'power3.out'
              }
            );


          const drawX =
            gsap.quickTo(
              blueprint,
              'x',
              {
                duration:
                  1,
                ease:
                  'power3.out'
              }
            );


          const drawY =
            gsap.quickTo(
              blueprint,
              'y',
              {
                duration:
                  1,
                ease:
                  'power3.out'
              }
            );


          hero.addEventListener(
            'mousemove',
            (event) => {

              const rect =
                hero.getBoundingClientRect();


              const px =
                (event.clientX -
                  rect.left) /
                  rect.width -
                .5;


              const py =
                (event.clientY -
                  rect.top) /
                  rect.height -
                .5;


              moveX(
                px * 12
              );

              moveY(
                py * 8
              );


              drawX(
                px * -7
              );

              drawY(
                py * -5
              );

            }
          );


          hero.addEventListener(
            'mouseleave',
            () => {

              moveX(0);
              moveY(0);

              drawX(0);
              drawY(0);

            }
          );

        }


        window.clearTimeout(
          safetyTimer
        );

      }

    } catch (err) {

      console.warn(
        '[CinematicHero] animation setup failed. Falling back to static hero.',
        err
      );

      window.clearTimeout(
        safetyTimer
      );

      clearEverything();

    }

  }

</script>