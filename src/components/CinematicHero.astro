---
// PBJ Infra — Cinematic Hero
//
// Design:
// Architectural / cinematic / premium
//
// Technical:
// - Astro static HTML
// - GSAP only for enhancement
// - No ScrollTrigger
// - Native video playback
// - Poster fallback
// - Full HTML content available without JS
// - Reduced-motion support
// - Safe animation fallback

const posterSrc = '/images/hero-poster.jpg';
---

<section class="hero-cinematic relative min-h-[100svh] overflow-hidden bg-ink text-paper" id="top"
  aria-labelledby="hero-title">
  <!-- =========================================================
       JS READY CONTRACT
  ========================================================== -->

  <script is:inline>
    (function (s) {
      if (s && s.parentElement) {
        s.parentElement.classList.add('js-ready');
      }
    })(document.currentScript);
  </script>


  <!-- =========================================================
       CINEMATIC VISUAL LAYER
  ========================================================== -->

  <div class="hero-visual absolute inset-0" aria-hidden="true">

    <!-- Video -->
    <div class="hero-video-wrap absolute inset-[-3%]">

      <video class="hero-bg-video absolute inset-0 h-full w-full object-cover" src="/videos/hero-bg.mp4"
        poster={posterSrc} autoplay muted loop playsinline preload="metadata"></video>

    </div>


    <!-- Image / video grading -->

    <div class="absolute inset-0 bg-black/15"></div>

    <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/15 to-transparent"></div>

    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/10"></div>


    <!-- Accent atmospheric glow -->

    <div class="hero-atmosphere absolute inset-0"></div>

  </div>


  <!-- =========================================================
       ARCHITECTURAL GRID
  ========================================================== -->

  <div class="hero-grid absolute inset-0 z-[1]" aria-hidden="true"></div>


  <!-- =========================================================
       TECHNICAL CORNER MARKS
  ========================================================== -->

  <div class="hero-corner hero-corner-tl" aria-hidden="true"></div>

  <div class="hero-corner hero-corner-br" aria-hidden="true"></div>



  <div class="wrap relative z-[5] flex min-h-[100svh] items-center justify-center py-40">

    <div class="hero-content flex w-full max-w-[1100px] flex-col items-center text-center">


      <!-- Eyebrow -->

      <div class="hero-eyebrow mb-6 flex items-center gap-3">

        <span class="h-px w-9 bg-accent"></span>

        <span class="font-mono text-[9px] uppercase tracking-[.2em] text-paper/65">
          Built for the way you imagine it
        </span>

      </div>


      <!-- =====================================================
           H1
      ====================================================== -->

      <h1 id="hero-title"
        class="hero-title font-serif text-[clamp(48px,7.8vw,108px)] leading-[.86] tracking-[-.045em]">

        <span class="mask-line block overflow-hidden">

          <span class="hero-title-line block">
            Whatever you imagine,
          </span>

        </span>


        <span class="mask-line block overflow-hidden">

          <span class="hero-title-line block text-paper/90">
            <span class="text-accent">we build it.</span>
          </span>

        </span>

      </h1>

      <div class="hero-actions mt-10 flex justify-center">

        <a href="/projects/" class="btn btn-solid hero-button" data-analytics-event="click_explore_work"
          data-analytics-params={JSON.stringify({ placement: 'hero' })}>
          Explore Our Work
          <span aria-hidden="true">→</span>
        </a>

      </div>

    </div>

  </div>


  <!-- =========================================================
       SCROLL INDICATOR
  ========================================================== -->

  <div class="hero-scroll absolute bottom-7 right-7 z-[5] hidden md:flex" aria-hidden="true">

    <div class="flex items-center gap-3">

      <span class="font-mono text-[8px] uppercase tracking-[.2em] text-paper/35">
        Scroll
      </span>

      <span class="hero-scroll-line block h-12 w-px bg-paper/25"></span>

    </div>

  </div>


  <!-- =========================================================
       NO JS FALLBACK
  ========================================================== -->

  <noscript>

    <div class="absolute bottom-5 left-5 z-[10]">

      <span class="font-mono text-[9px] text-paper/50">
        PBJ INFRA · DESIGN / ENGINEERING / BUILD
      </span>

    </div>

  </noscript>

</section>


<style>
  /* ==========================================================
     BASE
  ========================================================== */

  .hero-cinematic {
    isolation: isolate;
  }


  /* ==========================================================
     VIDEO
  ========================================================== */

  .hero-video-wrap {
    will-change: transform;
  }

  .hero-bg-video {
    transform: scale(1.06);
    filter:
      saturate(.86) contrast(1.03) brightness(.97);

    will-change: transform;
  }


  /* ==========================================================
     ATMOSPHERE
  ========================================================== */

  .hero-atmosphere {
    background:
      radial-gradient(circle at 72% 42%,
        rgba(30, 110, 100, .20),
        transparent 32%),
      radial-gradient(circle at 15% 85%,
        rgba(255, 255, 255, .04),
        transparent 28%);
  }


  /* ==========================================================
     GRID
  ========================================================== */

  .hero-grid {

    opacity: .07;

    background-image:
      linear-gradient(rgba(246, 243, 236, .28) 1px,
        transparent 1px),
      linear-gradient(90deg,
        rgba(246, 243, 236, .28) 1px,
        transparent 1px);

    background-size:
      80px 80px;

    mask-image:
      linear-gradient(to bottom,
        black 0%,
        rgba(0, 0, 0, .65) 55%,
        transparent 100%);
  }


  /* ==========================================================
     CORNER MARKS
  ========================================================== */

  .hero-corner {

    position: absolute;

    width: 45px;
    height: 45px;

    z-index: 3;

    opacity: .45;
  }

  .hero-corner::before,
  .hero-corner::after {

    content: '';

    position: absolute;

    background:
      rgba(246, 243, 236, .28);
  }

  .hero-corner::before {

    width: 45px;
    height: 1px;
  }

  .hero-corner::after {

    width: 1px;
    height: 45px;
  }

  .hero-corner-tl {

    top: 130px;
    left: 28px;
  }

  .hero-corner-br {

    right: 28px;
    bottom: 28px;
    transform: rotate(180deg);
  }


  /* ==========================================================
     TEXT
  ========================================================== */

  .mask-line {
    display: block;
    overflow: hidden;
  }

  .hero-title-line {

    will-change:
      transform;
  }


  /* ==========================================================
     INITIAL MOTION STATE
  ========================================================== */

  @media (prefers-reduced-motion: no-preference) {

    .hero-cinematic.js-ready .hero-title-line {

      transform:
        translateY(115%);
    }

    .hero-cinematic.js-ready .hero-eyebrow,
    .hero-cinematic.js-ready .hero-actions,
    .hero-cinematic.js-ready .hero-scroll {

      opacity: 0;
    }

  }


  /* ==========================================================
     BUTTON
  ========================================================== */

  .hero-button {

    transition:
      transform .45s cubic-bezier(.2, .7, .2, 1),
      background-color .3s ease,
      color .3s ease;
  }

  .hero-button:hover {

    transform:
      translateY(-3px);
  }


  /* ==========================================================
     SCROLL
  ========================================================== */

  .hero-scroll-line {

    transform-origin:
      top;

    animation:
      heroScroll 2s ease-in-out infinite;
  }

  @keyframes heroScroll {

    0%,
    100% {
      transform:
        scaleY(.45);
      opacity: .3;
    }

    50% {
      transform:
        scaleY(1);
      opacity: .8;
    }

  }


  /* ==========================================================
     MOBILE
  ========================================================== */

  @media (max-width: 640px) {

    .hero-grid {

      background-size:
        55px 55px;
    }

    .hero-bg-video {

      object-position:
        center center;
    }

    .hero-corner {

      display: none;
    }

  }


  /* ==========================================================
     REDUCED MOTION
  ========================================================== */

  @media (prefers-reduced-motion: reduce) {

    .hero-title-line,
    .hero-bg-video {

      transform: none !important;
    }

    .hero-eyebrow,
    .hero-actions,
    .hero-scroll {

      opacity: 1 !important;
    }

    .hero-scroll-line {

      animation: none !important;
    }

  }
</style>


<script>

  import { gsap } from 'gsap';


  const hero = document.querySelector('.hero-cinematic');


  if (hero) {

    /*
     * ========================================================
     * SAFETY FALLBACK
     * ========================================================
     */

    const clearEverything = () => {

      try {

        gsap.set(
          hero.querySelectorAll(
            '.hero-title-line, .hero-eyebrow, .hero-actions, .hero-scroll'
          ),
          {
            clearProps:
              'all'
          }
        );

      } catch {

        hero.classList.remove(
          'js-ready'
        );

      }

    };


    const safetyTimer =
      window.setTimeout(
        clearEverything,
        4000
      );


    try {

      const reduceMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;


      const isDesktop =
        window.matchMedia(
          '(min-width: 900px)'
        ).matches;


      const canHover =
        window.matchMedia(
          '(hover: hover) and (pointer: fine)'
        ).matches;


      const video = hero.querySelector('.hero-bg-video');


      const videoWrap = hero.querySelector('.hero-video-wrap');


      const titleLines = Array.from(
        hero.querySelectorAll('.hero-title-line')
      );


      const eyebrow = hero.querySelector('.hero-eyebrow');


      const actions = hero.querySelector('.hero-actions');


      const scroll = hero.querySelector('.hero-scroll');


      /* ======================================================
         REDUCED MOTION
      ====================================================== */

      if (reduceMotion) {

        video?.pause();

        window.clearTimeout(
          safetyTimer
        );

      } else {

        /* ====================================================
           INTRO TIMELINE
        ==================================================== */

        const intro =
          gsap.timeline({
            delay:
              .12,

            defaults: {
              ease:
                'power3.out'
            }
          });


        intro

          /* Video camera */

          .to(
            video,
            {
              scale:
                1,

              duration:
                2.1,

              ease:
                'power2.out'
            }
          )


          /* H1 */

          .to(
            titleLines,
            {
              y:
                0,

              duration:
                1.0,

              stagger:
                .12,

              ease:
                'power4.out'
            },
            '-=1.7'
          )


          /* Eyebrow */

          .to(
            eyebrow,
            {
              opacity:
                1,

              y:
                0,

              duration:
                .55
            },
            '-=.7'
          )


          /* Actions */

          .to(
            actions,
            {
              opacity:
                1,

              y:
                0,

              duration:
                .6
            },
            '-=.3'
          )


          /* Scroll */

          .to(
            scroll,
            {
              opacity:
                1,

              duration:
                .45
            },
            '-=.2'
          );


        /* ====================================================
           MOUSE DEPTH
        ==================================================== */

        if (
          canHover &&
          isDesktop &&
          videoWrap
        ) {

          const moveX =
            gsap.quickTo(
              videoWrap,
              'x',
              {
                duration:
                  .7,
                ease:
                  'power3.out'
              }
            );


          const moveY =
            gsap.quickTo(
              videoWrap,
              'y',
              {
                duration:
                  .7,
                ease:
                  'power3.out'
              }
            );


          hero.addEventListener(
            'mousemove',
            (event) => {

              const rect =
                hero.getBoundingClientRect();


              const px =
                (event.clientX -
                  rect.left) /
                rect.width -
                .5;


              const py =
                (event.clientY -
                  rect.top) /
                rect.height -
                .5;


              moveX(
                px * 12
              );

              moveY(
                py * 8
              );

            }
          );


          hero.addEventListener(
            'mouseleave',
            () => {

              moveX(0);
              moveY(0);

            }
          );

        }


        window.clearTimeout(
          safetyTimer
        );

      }

    } catch (err) {

      console.warn(
        '[CinematicHero] animation setup failed. Falling back to static hero.',
        err
      );

      window.clearTimeout(
        safetyTimer
      );

      clearEverything();

    }

  }

</script>