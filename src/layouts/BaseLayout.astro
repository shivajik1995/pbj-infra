---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
import PageAnimations from '../components/PageAnimations.astro';
import { SITE } from '../lib/site';
import { organizationSchema, websiteSchema } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string; // full <title>, already unique per page (≤60 chars recommended)
  description: string; // meta description, ≤160 chars
  path: string; // canonical path, e.g. "/services/swimming-pool-construction/"
  ogImage?: string;
  schema?: object[]; // additional JSON-LD objects (breadcrumb, service, faq, article…)
  noindex?: boolean;
}

const { title, description, path, ogImage, schema = [], noindex = false } = Astro.props;
const canonical = new URL(path, SITE.url).toString();
// Falls back to a real project photo rather than a placeholder graphic —
// until a dedicated 1200×630 OG asset is designed, this is the most accurate
// image available for unfurled links to /, /about/, /contact/. Relative paths
// (e.g. a page's own heroImage) are resolved to an absolute URL so social
// scrapers can fetch them.
const ogImg = new URL(ogImage ?? '/images/projects/ferrocement-dome-sunset-openings.jpg', SITE.url).toString();
const allSchema = [organizationSchema(), websiteSchema(), ...schema];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImg} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImg} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<!-- Self-hosting these three faces (subset, woff2) is the next performance
     step queued in docs/technical-seo-plan.md — Google Fonts CDN + preconnect
     is the pragmatic starting point so first paint isn't blocked. -->

{allSchema.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}

<script>
  import { initAnalytics, bindDelegatedTracking } from '../lib/analytics.client';
  initAnalytics();
  bindDelegatedTracking();
</script>
</head>
<noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
<body class="bg-paper text-ink font-sans antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[200] focus:top-3 focus:left-3 focus:bg-ink focus:text-paper focus:px-4 focus:py-2 focus:font-mono focus:text-xs">Skip to content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <WhatsAppFloat message="Hi PBJ Infra, I'd like to discuss a project." />
  <MobileStickyCTA />
  <PageAnimations />
</body>
</html>
