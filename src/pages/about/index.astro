---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import RevealScript from '../../components/RevealScript.astro';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';
import { SITE } from '../../lib/site';

const team = await getCollection('team');
const faqSlugs = ['permits', 'design-and-build', 'warranty', 'locations-served'];
const faqs = (await Promise.all(faqSlugs.map((id) => getEntry('faq', id)))).map((f) => f!.data);
const crumbs = [{ name: 'Home', url: '/' }, { name: 'About', url: '/about/' }];
---
<BaseLayout
  title="About PBJ Infra | Construction Company Since 2009"
  description="PBJ Infra is a Pune-headquartered construction company operating since 2009, led by founder Padmasinha Bapurao Jadhav. GST and UDYAM registered, 5-year structural warranty."
  path="/about/"
  schema={[breadcrumbSchema(crumbs), faqSchema(faqs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="wrap pt-8 pb-16">
    <h1 class="text-[32px] md:text-[48px] max-w-[20ch]">Built on-site, not on adjectives.</h1>
    <p class="mt-6 max-w-[64ch] text-ink-soft text-lg">{SITE.description}</p>
  </section>

  <section class="py-16 bg-paper-dim">
    <div class="wrap grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-ink/[.14] border border-ink/[.14]">
      {[
        ['2009', 'Operating continuously since'],
        ['5 / 2 Yrs', 'Structural / equipment warranty'],
        [SITE.gst, 'GST registration'],
        [SITE.udyam, 'UDYAM registration'],
      ].map(([v, l]) => (
        <div class="bg-paper p-7">
          <div class="font-serif text-2xl">{v}</div>
          <div class="font-mono text-[10.5px] tracking-wide uppercase text-ink/50 mt-2">{l}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap py-16 max-w-[74ch]">
    <h2 class="font-serif text-3xl mb-5">How PBJ works</h2>
    <p class="text-ink-soft mb-4 leading-relaxed">PBJ Infra handles design, structural engineering, construction and finishing under one in-house team — 3D visualization and transparent cost estimation before ground is broken, then site preparation, structural work, systems (filtration, waterproofing, mechanical) and finishing carried out and checked in sequence, with regular progress updates back to the client.</p>
    <p class="text-ink-soft leading-relaxed">Permits, approvals and regulatory compliance with local building authorities are handled directly by PBJ, and every build carries a 5-year structural warranty and 2-year equipment warranty covering defects in materials or workmanship under normal use.</p>
  </section>

  <section class="py-16">
    <div class="wrap">
      <h2 class="font-serif text-3xl mb-10">Behind every build, there's a team.</h2>
      {team.map((member) => (
        <div class="grid md:grid-cols-[.7fr_1.3fr] gap-12 items-center">
          <div class="spec-frame aspect-[4/5]">
            <span class="cA"></span><span class="cB"></span>
            <img src={member.data.photo.src} alt={member.data.photo.alt} width={member.data.photo.width} height={member.data.photo.height} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div>
            <span class="font-mono text-[11px] text-accent tracking-wide uppercase">{member.data.role}</span>
            <h3 class="font-serif text-3xl md:text-4xl mt-3 mb-5">{member.data.name}</h3>
            <p class="text-ink-soft max-w-[52ch] mb-6">{member.data.bio}</p>
            <div class="flex gap-6 flex-wrap font-mono text-xs">
              {member.data.email && <a href={`mailto:${member.data.email}`} data-analytics-event="click_email" class="hover:text-accent">{member.data.email}</a>}
              {member.data.phone && <a href={`tel:${member.data.phone.replace(/\s/g, '')}`} data-analytics-event="click_phone" class="hover:text-accent">{member.data.phone}</a>}
            </div>
            <div class="mt-9 pt-6 border-t border-dashed border-ink/[.14] font-mono text-[11.5px] text-warn">Content requirement: additional team/site-engineer profiles aren't published yet. Adding 2–3 more names and roles would strengthen this section further.</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap py-16 max-w-[880px]">
    <h2 class="font-serif text-3xl mb-4">FAQ</h2>
    <FAQAccordion items={faqs} idPrefix="about-faq" />
  </section>

  <section class="bg-ink text-paper py-20 text-center">
    <div class="wrap">
      <h2 class="font-serif text-3xl md:text-4xl">Have a project in mind?</h2>
      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href="/contact/" class="btn btn-solid" data-analytics-event="click_start_project" data-analytics-params={JSON.stringify({ placement: 'about_cta' })}>Start Your Project →</a>
      </div>
    </div>
  </section>

  <RevealScript />
</BaseLayout>
