---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageShell from '../../components/PageShell.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { breadcrumbSchema } from '../../lib/schema';

const articles = (await getCollection('articles', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Resources', url: '/resources/' }];
---
<BaseLayout
  title="Construction Guides & Resources | PBJ Infra"
  description="Practical guides on pool construction timelines, planning and more from PBJ Infra — answers to real questions, not marketing filler."
  path="/resources/"
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    tone="ink"
    eyebrow="Resources / Guides"
    title="Guides worth reading"
    titleMuted="before you build."
    lead="A small, growing set of articles answering real questions PBJ hears at consultation — not dozens of thin, auto-generated posts. Each one links to the service and project it's actually about."
  />

  <PageShell tone="paper">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" data-reveal-stagger>
      {articles.map((a) => (
        <a href={`/resources/${a.slug}/`} class="group block glass-paper rounded-2xl overflow-hidden hover:border-accent/50 transition-colors">
          <div class="aspect-[16/10] overflow-hidden">
            <img src={a.data.heroImage.src} alt={a.data.heroImage.alt} width={a.data.heroImage.width} height={a.data.heroImage.height} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
          <div class="p-6">
            <h2 class="font-serif text-xl mb-2">{a.data.title}</h2>
            <p class="text-[13.5px] text-ink-soft">{a.data.dek}</p>
            <span class="inline-block mt-4 font-mono text-xs tracking-wide uppercase text-ink group-hover:text-accent">Read guide →</span>
          </div>
        </a>
      ))}
    </div>
  </PageShell>

  <FinalCTA
    title="Have a question"
    titleMuted="we haven't answered?"
    copy="Bring it to a consultation — PBJ Infra would rather talk through your specific project than write another generic article."
    primary={{ label: 'Start a project', href: '/contact/', event: 'click_start_project', params: { placement: 'resources_cta' } }}
    contact={true}
  />
</BaseLayout>
