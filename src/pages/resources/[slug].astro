---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageShell from '../../components/PageShell.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { breadcrumbSchema, articleSchema } from '../../lib/schema';
import { whatsappLink } from '../../lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status === 'published');
  return articles.map((a) => ({ params: { slug: a.slug }, props: { entry: a } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const relatedServices = d.relatedServices ? (await Promise.all(d.relatedServices.map((r) => getEntry(r)))).filter(Boolean) : [];
const relatedProjects = d.relatedProjects ? (await Promise.all(d.relatedProjects.map((r) => getEntry(r)))).filter(Boolean) : [];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Resources', url: '/resources/' },
  { name: d.title, url: `/resources/${entry.slug}/` },
];
const published = d.publishDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  path={`/resources/${entry.slug}/`}
  ogImage={d.heroImage.src}
  schema={[
    breadcrumbSchema(crumbs),
    articleSchema({ headline: d.title, description: d.dek, url: `/resources/${entry.slug}/`, image: d.heroImage.src, datePublished: d.publishDate, dateModified: d.updatedDate }),
  ]}
>
  <PageHero
    crumbs={crumbs}
    tone="paper"
    size="article"
    eyebrow="Resources / Guide"
    metaRight={`Published ${published}`}
    title={d.title}
    lead={d.dek}
  />

  <section class="bg-paper">
    <img src={d.heroImage.src} alt={d.heroImage.alt} width={d.heroImage.width} height={d.heroImage.height} class="w-full max-h-[520px] object-cover" fetchpriority="high" decoding="async" />
  </section>

  <PageShell tone="paper">
    <div class="prose-content max-w-[74ch]" data-reveal>
      <Content />
    </div>
  </PageShell>

  {(relatedServices.length > 0 || relatedProjects.length > 0) && (
    <PageShell tone="paper-dim">
      <div class="flex flex-wrap gap-x-10 gap-y-4" data-reveal>
        {relatedServices.map((s) => s && (
          <a href={s.data.status === 'published' ? `/services/${s.slug}/` : '/services/'} class="font-mono text-sm text-accent hover:underline">Related service: {s.data.name} →</a>
        ))}
        {relatedProjects.map((p) => p && (
          <a href={p.data.status === 'published' ? `/projects/${p.slug}/` : '/projects/'} class="font-mono text-sm text-accent hover:underline">Related project: {p.data.name} →</a>
        ))}
      </div>
    </PageShell>
  )}

  <FinalCTA
    eyebrow="Start a project"
    title="Ready to start"
    titleMuted="planning?"
    primary={{ label: 'Start your project', href: '/contact/', event: 'click_start_project', params: { placement: 'article_cta' } }}
    secondary={{ label: 'WhatsApp us', href: whatsappLink('Hi PBJ Infra, I read your article and would like to discuss a project.'), external: true, event: 'click_whatsapp' }}
  />
</BaseLayout>

<style>
  .prose-content :global(h2) { font-family: theme('fontFamily.serif'); font-size: clamp(24px, 2.8vw, 32px); margin: 2.2rem 0 0.75rem; letter-spacing: -0.02em; }
  .prose-content :global(h2:first-child) { margin-top: 0; }
  .prose-content :global(p) { color: theme('colors.ink-soft'); margin-bottom: 1rem; line-height: 1.75; }
  .prose-content :global(ul) { margin: 0 0 1.25rem 1.1rem; list-style: disc; color: theme('colors.ink-soft'); }
  .prose-content :global(li) { margin-bottom: 0.4rem; line-height: 1.7; }
  .prose-content :global(a) { color: theme('colors.accent'); text-decoration: underline; }
  .prose-content :global(strong) { color: theme('colors.ink'); }
</style>
