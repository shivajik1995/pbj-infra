---
import BaseLayout from '../layouts/BaseLayout.astro';
import GridTexture from '../components/GridTexture.astro';
---
<BaseLayout
  title="Page Not Found | PBJ Infra"
  description="This page could not be found. Head back to the PBJ Infra homepage, services, projects or contact page."
  path="/404"
  noindex={true}
>
  <section class="relative flex min-h-[82svh] flex-col justify-center overflow-hidden bg-ink py-24 text-paper">
    <GridTexture tone="dark" />
    <div class="wrap relative z-[2]">
      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-accent"></span>
        <span class="font-mono text-[9px] uppercase tracking-[.2em] text-paper/45">404 / Not found</span>
      </div>
      <h1 class="mt-6 max-w-[16ch] font-serif text-[clamp(44px,8vw,104px)] leading-[.86] tracking-[-.045em]">
        This page <span class="heading-accent">isn't here.</span>
      </h1>
      <p class="mt-7 max-w-[54ch] text-[14px] leading-[1.75] text-paper/60 md:text-[15px]">
        The link may be broken or the page may have moved. Here's the way back:
      </p>
      <ul class="mt-9 flex flex-wrap gap-x-8 gap-y-3 font-mono text-[12px] tracking-wide uppercase">
        <li><a href="/" class="text-accent hover:underline">Home →</a></li>
        <li><a href="/services/" class="text-accent hover:underline">Services →</a></li>
        <li><a href="/projects/" class="text-accent hover:underline">Projects →</a></li>
        <li><a href="/locations/" class="text-accent hover:underline">Locations →</a></li>
        <li><a href="/contact/" class="text-accent hover:underline">Contact →</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
