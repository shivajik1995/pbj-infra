<script is:inline define:vars={{ clientLocationData }}>
  const selectors = Array.from(
    document.querySelectorAll('[data-location-select]')
  );

  const typeEl = document.querySelector('[data-selected-type]');
  const titleEl = document.querySelector('[data-selected-title]');
  const locationEl = document.querySelector('[data-selected-location]');
  const numberEl = document.querySelector('[data-selected-number]');
  const projectsEl = document.querySelector('[data-selected-projects]');

  const dataByCity = new Map(
    clientLocationData.map((item) => [item.city, item])
  );

  function activateLocation(city) {
    selectors.forEach((selector) => {
      selector.classList.toggle(
        'is-active',
        selector.dataset.locationSelect === city
      );
    });

    if (city === 'Pan India') {
      if (typeEl) typeEl.textContent = 'Service coverage';
      if (titleEl) titleEl.textContent = 'Pan India';
      if (locationEl) locationEl.textContent = 'India';
      if (numberEl) numberEl.textContent = '∞';

      if (projectsEl) {
        projectsEl.innerHTML = `
          <span>PBJ Infra</span>
          <p>
            Construction and project execution services available across India.
          </p>
        `;
      }

      return;
    }

    const data = dataByCity.get(city);
    if (!data) return;

    if (typeEl) typeEl.textContent = data.type;
    if (titleEl) titleEl.textContent = data.city;
    if (locationEl) locationEl.textContent = data.location;
    if (numberEl) numberEl.textContent = data.number;

    if (projectsEl) {
      if (data.projects.length) {
        projectsEl.innerHTML = `
          <span>Published projects</span>
          <div>
            ${data.projects
              .map(
                (project) => `
                  <a href="/projects/${project.slug}/">
                    ${project.name}${project.year ? ` · ${project.year}` : ''}
                  </a>
                `
              )
              .join('')}
          </div>
        `;
      } else {
        projectsEl.innerHTML = `
          <span>PBJ Infra</span>
          <p>Verified location associated with PBJ Infra.</p>
        `;
      }
    }
  }

  selectors.forEach((selector) => {
    selector.addEventListener('click', () => {
      const city = selector.dataset.locationSelect;
      if (city) activateLocation(city);
    });
  });

  activateLocation('Pune');
</script>
