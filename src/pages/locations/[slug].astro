---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageShell from '../../components/PageShell.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { breadcrumbSchema, localBusinessSchema, faqSchema } from '../../lib/schema';
import { whatsappLink } from '../../lib/site';

export async function getStaticPaths() {
  const locations = await getCollection('locations', ({ data }) => data.status === 'published');
  return locations.map((l) => ({ params: { slug: l.slug }, props: { entry: l } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const services = await Promise.all(d.servicesOffered.map((s) => getEntry(s)));
const relatedProjects = d.relatedProjects
  ? (await Promise.all(d.relatedProjects.map((r) => getEntry(r)))).filter((p) => p && p.data.status === 'published')
  : [];
const faqs = d.faq ? (await Promise.all(d.faq.map((r) => getEntry(r)))).map((f) => f!.data) : [];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Locations', url: '/locations/' },
  { name: d.name, url: `/locations/${entry.slug}/` },
];
---
<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  path={`/locations/${entry.slug}/`}
  schema={[
    breadcrumbSchema(crumbs),
    ...(d.address ? [localBusinessSchema()] : []),
    ...(faqs.length ? [faqSchema(faqs)] : []),
  ]}
>
  <PageHero
    crumbs={crumbs}
    tone="ink"
    eyebrow={`Locations / ${d.role}`}
    metaRight={d.address}
    title={`Construction Company in ${d.name}`}
    lead={d.intro}
    ctas={[
      { label: 'Start your project', href: '/contact/', style: 'solid', event: 'click_start_project', params: { placement: 'location_hero', location: entry.slug } },
      { label: 'WhatsApp us', href: whatsappLink(`Hi PBJ Infra, I'm looking to discuss a project in ${d.name}.`), style: 'lt', external: true, event: 'click_whatsapp' },
    ]}
  />

  <PageShell tone="paper">
    <div class="prose-content max-w-[74ch]" data-reveal>
      <Content />
    </div>
  </PageShell>

  <PageShell tone="paper-dim">
    <div class="grid md:grid-cols-2 gap-12" data-reveal>
      <div>
        <h2 class="font-serif text-2xl mb-6">Services offered in {d.name}</h2>
        <ul class="flex flex-col gap-3">
          {services.map((s) => s && (
            <li><a href={s.data.status === 'published' ? `/services/${s.slug}/` : '/services/'} class="font-mono text-sm text-accent hover:underline">{s.data.name} →</a></li>
          ))}
        </ul>
      </div>
      {d.localNotes.length > 0 && (
        <div>
          <h2 class="font-serif text-2xl mb-6">Verified local notes</h2>
          <ul class="flex flex-col gap-4">
            {d.localNotes.map((n) => <li class="text-[14px] text-ink-soft border-l-2 border-accent pl-4">{n}</li>)}
          </ul>
        </div>
      )}
    </div>
  </PageShell>

  {relatedProjects.length > 0 && (
    <PageShell tone="paper">
      <h2 class="font-serif text-2xl mb-6" data-reveal>PBJ Infra projects in {d.name}</h2>
      <ul class="flex flex-col gap-3" data-reveal-stagger>
        {relatedProjects.map((p) => p && (
          <li>
            <a href={`/projects/${p.slug}/`} class="font-mono text-sm text-accent hover:underline">{p.data.name} — {p.data.projectType} →</a>
          </li>
        ))}
      </ul>
    </PageShell>
  )}

  {faqs.length > 0 && (
    <PageShell tone="paper-dim" labelledby="loc-faq">
      <SectionHeader id="loc-faq" label={`Building in ${d.name}`} title="FAQ" tone="paper" />
      <div class="mt-12 max-w-[880px]" data-reveal>
        <FAQAccordion items={faqs} idPrefix={`loc-${entry.slug}`} />
      </div>
    </PageShell>
  )}

  <FinalCTA
    eyebrow="Start a project"
    title="Building in"
    titleMuted={`${d.name}?`}
    primary={{ label: 'Start your project', href: '/contact/', event: 'click_start_project', params: { placement: 'location_cta', location: entry.slug } }}
    secondary={{ label: 'WhatsApp us', href: whatsappLink(`Hi PBJ Infra, I'm looking to discuss a project in ${d.name}.`), external: true, event: 'click_whatsapp' }}
    contact={true}
    coverageNote={`${d.name} · Maharashtra · India`}
  />
</BaseLayout>

<style>
  .prose-content :global(h2) { font-family: theme('fontFamily.serif'); font-size: clamp(24px, 2.8vw, 32px); margin: 2.2rem 0 0.75rem; letter-spacing: -0.02em; }
  .prose-content :global(h2:first-child) { margin-top: 0; }
  .prose-content :global(p) { color: theme('colors.ink-soft'); margin-bottom: 1rem; line-height: 1.75; }
  .prose-content :global(a) { color: theme('colors.accent'); text-decoration: underline; }
  .prose-content :global(strong) { color: theme('colors.ink'); }
</style>
