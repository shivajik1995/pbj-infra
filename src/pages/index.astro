<script>

  // Sticky left panel + scrolling right column — same mechanic as the
  // project navigator on /projects/ (an IntersectionObserver tracks which
  // card is centred in view and updates the sticky panel's text).
  const buildCards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-build-card]')
  );

  const buildNumber = document.querySelector<HTMLElement>('[data-build-number]');
  const buildTitle = document.querySelector<HTMLElement>('[data-build-title]');
  const buildDescription = document.querySelector<HTMLElement>('[data-build-description]');

  const reduceBuildMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  let activeBuildIndex = -1;

  const setActiveBuild = (card: HTMLElement) => {
    const index = Number(card.dataset.buildIndex || 0);
    if (index === activeBuildIndex) return;

    activeBuildIndex = index;

    if (buildNumber) {
      buildNumber.textContent = card.dataset.buildNumber || '01';
    }

    if (buildTitle) {
      buildTitle.textContent = card.dataset.buildName || '';
    }

    if (buildDescription) {
      buildDescription.textContent = card.dataset.buildDescription || '';
    }

    buildCards.forEach((item, i) => {
      item.classList.toggle('is-active', i === index);
    });

    if (!reduceBuildMotion) {
      [buildNumber, buildTitle, buildDescription].forEach((el) => {
        if (!el) return;
        el.animate(
          [
            { opacity: 0.25, transform: 'translateY(7px)' },
            { opacity: 1, transform: 'translateY(0)' },
          ],
          { duration: 320, easing: 'cubic-bezier(.2,.65,.25,1)' },
        );
      });
    }
  };

  if (buildCards.length) {
    const buildObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

        if (visible.length) {
          setActiveBuild(visible[0].target as HTMLElement);
        }
      },
      {
        threshold: [0.08, 0.2, 0.45, 0.65],
        rootMargin: '-22% 0px -55% 0px',
      },
    );

    buildCards.forEach((card) => buildObserver.observe(card));
    setActiveBuild(buildCards[0]);
  }

</script>

