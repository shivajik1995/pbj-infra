---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CinematicHero from '../components/CinematicHero.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { whatsappLink, telLink, mailtoLink } from '../lib/site';
import { faqSchema, serviceItemListSchema } from '../lib/schema';
import { getGoogleReviews } from '../lib/googleReviews';

// Primary service pages — drives the homepage "What We Build" links and the
// ItemList structured data. Keep in sync with src/content/services/.
const primaryServices = [
  { name: 'Swimming Pool Construction', url: '/services/swimming-pool-construction/' },
  { name: 'Pool Filtration Systems', url: '/services/pool-filtration-systems/' },
  { name: 'Pool Tiling & Finishing', url: '/services/swimming-pool-tiles/' },
  { name: 'Lagoon Pool Construction', url: '/services/lagoon-pool-construction/' },
  { name: 'Waterpark Construction', url: '/services/waterpark-construction/' },
  { name: 'Resort Construction', url: '/services/resort-construction/' },
  { name: 'Farmhouse Construction', url: '/services/farmhouse-construction/' },
  { name: 'Cob House Construction', url: '/services/cob-house-construction/' },
  { name: 'Ferro Concrete Design', url: '/services/ferro-concrete-design/' },
  { name: 'Ferrocement Dome', url: '/services/ferrocement-dome/' },
  { name: 'Land Development', url: '/services/land-development/' },
];

// "What We Build" capability showcase — sticky-left / scrolling-right index,
// same pattern as the project navigator on /projects/. One card per row.
const buildCapabilities = [
  {
    key: 'aquatic',
    category: 'Aquatic',
    name: 'Swimming Pools',
    description: 'From private pools to destination-scale aquatic environments.',
    image: 'https://pbjinfra.com/assets/images/swimming-pool.jpg',
    alt: 'A completed swimming pool with mosaic tiling, built by PBJ Infra',
  },
  {
    key: 'hospitality',
    category: 'Hospitality',
    name: 'Resorts & Destinations',
    description: 'Built environments designed around experience, flow and place.',
    image: 'https://pbjinfra.com/assets/images/resort.jpg',
    alt: 'A resort building beside a landscaped pool, built by PBJ Infra',
  },
  {
    key: 'recreation',
    category: 'Recreation',
    name: 'Waterparks',
    description: 'Complex aquatic infrastructure engineered for high-use environments.',
    image: 'https://pbjinfra.com/assets/images/waterpark-construction-services.jpg',
    alt: 'Waterpark slides and attraction pools built by PBJ Infra',
  },
  {
    key: 'specialized',
    category: 'Specialized',
    name: 'Bespoke Structures',
    description: "Custom structural solutions for projects that don't fit a template.",
    image: 'https://pbjinfra.com/assets/images/DOM.jpeg',
    alt: 'A curved ferrocement dome structure built by PBJ Infra',
  },
];

// Developers whose projects PBJ Infra has worked with, per pbjinfra.com's
// own clients section — same [name, type] shape and copy as the /about/
// page's `clients` list, so both render the identical marquee.
const developers: [string, string][] = [
  ['Panchshil Realty', 'Real estate development'],
  ['Godrej Properties', 'Real estate development'],
  ['Nyati Group', 'Real estate development'],
  ['Kolte Patil Developers', 'Real estate development'],
  ['Majestique Landmarks', 'Real estate development'],
  ['Ajmera Group', 'Real estate development'],
  ['Mahindra Lifespaces', 'Real estate development'],
  ['D.Y. Patil', 'Institutional / development'],
];

const projects = await getCollection('projects');
const projectOrder = ['adventure-waterpark-ahilyanagar', 'jalashay-resort-panshet', 'akaya-resort-gokarna', 'aandra-lakestay-resort-pune', 'takawe-resort-kamshet', 'hotel-ak-gemak-kolhapur', 'mi-casa-kanakapura', 'latur-water-park', 'luxury-infinity-pool', 'rabbit-dome-house', 'natural-lagoon-pool',
'farm-house-latur'];
const orderedProjects = projectOrder.map((slug) => projects.find((p) => p.slug === slug)!).filter(Boolean);

const faqSlugs = ['pool-timeline', 'warranty', 'permits', 'design-and-build', 'cost'];
const faqs = await Promise.all(faqSlugs.map((id) => getEntry('faq', id)));
const faqItems = faqs.filter(Boolean).map((f) => f!.data);

// Google reviews — real, build-time data only (see lib/googleReviews.ts).
// `available: false` (unset API env vars, or a failed fetch) renders the
// honest "pending connection" state below — never a fabricated rating or
// invented review text.
const googleReviews = await getGoogleReviews();
const gRatingDisplay = googleReviews.available && googleReviews.rating != null ? googleReviews.rating.toFixed(1) : '—.—';
const gRoundedRating = Math.round(googleReviews.rating ?? 0);
const gStars = googleReviews.available ? '★'.repeat(gRoundedRating) + '☆'.repeat(5 - gRoundedRating) : '★★★★★';
const gCountDisplay = googleReviews.available
  ? `${googleReviews.userRatingCount ?? 0} Google reviews`
  : 'Google rating · pending connection';
const gProfileUrl = googleReviews.profileUrl ?? 'https://www.google.com/maps/search/?api=1&query=PBJ+Infra';
const gReviews = googleReviews.available ? (googleReviews.reviews ?? []).slice(0, 3) : [];
---
<BaseLayout title="Construction Company in Pune & Latur | PBJ Infra"
  description="PBJ Infra builds swimming pools, waterparks, resorts, farmhouses and specialised structures across Pune, Latur and Maharashtra. Operating since 2009."
  path="/" schema={[serviceItemListSchema(primaryServices), faqSchema(faqItems)]}>
  <!-- ============ HERO ============ -->
  <CinematicHero />


  <!-- ============ SIGNATURE PROJECTS ============ -->

  <section id="projects" class="projects-showcase relative overflow-hidden bg-ink text-paper py-24 md:py-36"
    aria-labelledby="projects-title">

    <!-- Ambient glow — same teal dark-glow recipe used on every bg-ink
         PageHero site-wide, so this section reads as the same dark
         surface language rather than a one-off treatment. -->

    <div class="projects-glow absolute inset-0" aria-hidden="true"></div>


    <!-- Background technical grid -->

    <div class="projects-grid absolute inset-0" aria-hidden="true"></div>


    <div class="wrap relative z-[2]">


      <!-- =====================================================
         SECTION HEADER
    ====================================================== -->

      <div class="projects-header flex flex-col items-center py-10 text-center md:py-16">

        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-accent"></span>
          <span class="font-mono text-[12px] uppercase tracking-[.24em] text-paper/45">
            02 / Signature Projects
          </span>
          <span class="h-px w-8 bg-accent"></span>
        </div>

        <h2 id="projects-title"
          class="projects-title mx-auto mt-7 max-w-[16ch] font-serif text-[clamp(42px,6vw,82px)] leading-[.92] tracking-[-.04em]">
          Built environments,
          <span class="heading-accent">
            not just structures.
          </span>
        </h2>

        <p class="projects-intro mx-auto mt-7 max-w-[600px] text-[14px] leading-[1.75] text-paper/55 md:text-[15px]">
          From immersive aquatic spaces to destination hospitality and
          one-of-a-kind residential structures, every PBJ project is
          engineered around the way it will actually be experienced.
        </p>

      </div>


      <!-- =====================================================
         PROJECT LIST
    ====================================================== -->

      <div class="projects-list mt-20 md:mt-28">

        {orderedProjects.map((p, i) => {
          const hasPage = p.data.status !== 'draft';
          const inProgress = p.data.status === 'in-progress';
          const href = hasPage ? `/projects/${p.slug}/` : '/projects/';
          return (
            <a href={href}
              class="project-item group grid gap-7 border-t border-paper/[.14] py-10 md:grid-cols-[80px_1fr_1.2fr_100px] md:items-center md:py-14">

              <div class="project-number font-mono text-[12px] text-paper/30">
                {String(i + 1).padStart(2, '0')}
              </div>

              <div>

                <span class="project-category font-mono text-[12px] uppercase tracking-[.16em] text-accent">
                  {p.data.projectType}
                </span>

                <h3 class="project-name mt-3 font-serif text-[30px] leading-none tracking-[-.025em] md:text-[40px]">
                  {p.data.name}
                </h3>

                <p class="project-location mt-3 font-mono text-[12px] uppercase tracking-[.12em] text-paper/35">
                  {p.data.location}
                </p>

              </div>

              <!-- Image -->

              <div class="project-image-wrap relative aspect-[16/9] overflow-hidden bg-paper/5">

                <img src={p.data.heroImage.src} alt={p.data.heroImage.alt}
                  loading="lazy" decoding="async" width="1200" height="675" class="project-image h-full w-full object-cover" />

                <div class="absolute inset-0 bg-black/10 transition duration-700 group-hover:bg-black/0"></div>

                <!-- technical frame -->

                <div class="project-frame absolute inset-4 border border-paper/20"></div>

                <!-- Hover label -->

                <div class="project-hover absolute bottom-5 left-5 flex items-center gap-3">

                  <span
                    class="flex h-9 w-9 items-center justify-center rounded-full border border-paper/35 bg-black/20 backdrop-blur-sm">
                    →
                  </span>

                  <span class="font-mono text-[12px] uppercase tracking-[.15em]">
                    {inProgress ? 'View progress' : hasPage ? 'View project' : 'Case study in development'}
                  </span>

                </div>

              </div>

              <div class="hidden justify-self-end md:block">

                <span class="project-arrow font-mono text-xl text-paper/30">
                  ↗
                </span>

              </div>

            </a>
          );
        })}

      </div>


      <!-- =====================================================
         ALL PROJECTS CTA
    ====================================================== -->

      <div class="projects-footer flex justify-between items-center pt-10">

        <span class="font-mono text-[12px] uppercase tracking-[.16em] text-paper/30">
          Selected PBJ work
        </span>

        <a href="/projects/"
          class="projects-all group flex items-center gap-3 font-mono text-[12px] uppercase tracking-[.15em]">

          <span>
            Explore all projects
          </span>

          <span class="transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>

        </a>

      </div>

    </div>

  </section>


  <style>
    /* ==========================================================
     BACKGROUND
     (.heading-accent — the shared teal accent + glow treatment
     used on every heading's highlighted phrase — lives globally
     in src/styles/global.css.)
  ========================================================== */

    .projects-showcase {
      isolation: isolate;
    }


    .projects-glow {

      background:
        radial-gradient(50% 60% at 85% 8%, rgba(30, 110, 100, .14), transparent 70%),
        radial-gradient(60% 70% at 0% 100%, rgba(30, 110, 100, .07), transparent 70%),
        radial-gradient(140% 90% at 50% -10%, rgba(246, 243, 236, .05), transparent 60%);
    }


    .projects-grid {

      opacity: .035;

      background-image:
        linear-gradient(rgba(246, 243, 236, .4) 1px,
          transparent 1px),
        linear-gradient(90deg,
          rgba(246, 243, 236, .4) 1px,
          transparent 1px);

      background-size:
        80px 80px;

      mask-image:
        linear-gradient(to bottom,
          transparent,
          black 10%,
          black 90%,
          transparent);
    }


    /* ==========================================================
     PROJECT IMAGE
  ========================================================== */

    .project-image-wrap {

      transform:
        translateZ(0);

      overflow:
        hidden;
    }


    .project-image {

      transform:
        scale(1.04);

      filter:
        saturate(.78) contrast(1.04);

      transition:
        transform 1s cubic-bezier(.2, .7, .2, 1),
        filter 700ms ease;

      will-change:
        transform;
    }


    .project-item:hover .project-image {

      transform:
        scale(1.09);

      filter:
        saturate(.95) contrast(1.02);
    }


    /* ==========================================================
     FRAME
  ========================================================== */

    .project-frame {

      transform:
        scale(.96);

      opacity:
        .35;

      transition:
        transform .8s cubic-bezier(.2, .7, .2, 1),
        opacity .5s ease;
    }


    .project-item:hover .project-frame {

      transform:
        scale(1);

      opacity:
        .75;
    }


    /* ==========================================================
     HOVER ARROW
  ========================================================== */

    .project-arrow {

      transition:
        transform .4s cubic-bezier(.2, .7, .2, 1),
        color .3s ease;
    }


    .project-item:hover .project-arrow {

      transform:
        translate(4px, -4px);

      color:
        rgba(246, 243, 236, .9);
    }


    /* ==========================================================
     PROJECT TEXT
  ========================================================== */

    .project-name {

      transition:
        transform .45s cubic-bezier(.2, .7, .2, 1);
    }


    .project-item:hover .project-name {

      transform:
        translateX(7px);
    }


    .project-hover {

      opacity:
        .75;

      transition:
        opacity .35s ease,
        transform .45s cubic-bezier(.2, .7, .2, 1);

      transform:
        translateY(5px);
    }


    .project-item:hover .project-hover {

      opacity:
        1;

      transform:
        translateY(0);
    }


    /* ==========================================================
     MOBILE
  ========================================================== */

    @media (max-width: 768px) {

      .projects-grid {

        background-size:
          55px 55px;
      }

      .project-image-wrap {

        aspect-ratio:
          16 / 10;
      }

    }


    /* ==========================================================
     REDUCED MOTION
  ========================================================== */

    @media (prefers-reduced-motion: reduce) {

      .project-image,
      .project-frame,
      .project-name,
      .project-hover {

        transition:
          none !important;

        transform:
          none !important;
      }

    }
  </style>


  <!-- ============ WHAT WE BUILD ============ -->
  <!-- =========================================================
     SECTION 03 — WHAT WE BUILD
========================================================== -->

<section
  id="services"
  class="build-section relative overflow-clip bg-paper text-ink py-24 md:py-36"
  aria-labelledby="build-title"
>

  <div class="build-bg-grid absolute inset-0" aria-hidden="true"></div>


  <div class="wrap relative z-[2]">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="build-header flex flex-col items-center py-10 text-center md:py-16">

      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-accent"></span>
        <span class="font-mono text-[12px] uppercase tracking-[.24em] text-ink/45">
          03 / What We Build
        </span>
        <span class="h-px w-8 bg-accent"></span>
      </div>

      <h2
        id="build-title"
        class="build-title mx-auto mt-7 max-w-[16ch] font-serif text-[clamp(44px,6vw,82px)] leading-[.92] tracking-[-.045em]"
      >
        Spaces with a purpose.
        <span class="heading-accent">
          Built with precision.
        </span>
      </h2>

      <p class="build-intro mx-auto mt-7 max-w-[600px] text-[14px] leading-[1.75] text-ink/55 md:text-[15px]">
        PBJ combines construction expertise, engineering discipline and
        practical execution to create environments that are made to last.
      </p>

    </div>


    <!-- =====================================================
         CAPABILITY INDEX — sticky left panel, scrolling right
         column of cards. Same pattern as the project navigator
         on /projects/ (.projects-panel / .projects-cards-stack).
    ====================================================== -->

    <div class="build-showcase mt-20">

      <aside class="build-panel" aria-label="PBJ Infra capabilities">
        <div class="build-sticky">

          <div class="build-number-wrap">
            <span class="build-number-current" data-build-number>01</span>
            <span class="build-number-line"></span>
          </div>

          <p class="build-label">Capability</p>

          <h3 class="build-panel-title" data-build-title>
            {buildCapabilities[0].name}
          </h3>

          <p class="build-panel-description" data-build-description>
            {buildCapabilities[0].description}
          </p>

          <div class="build-meta">
            <span class="build-meta-line"></span>
            <span><strong data-build-count>{String(buildCapabilities.length).padStart(2, '0')}</strong> capabilities</span>
          </div>

          <div class="build-scroll-indicator">
            <div class="build-scroll-track"><span></span></div>
            <span>Scroll to explore</span>
          </div>

        </div>
      </aside>

      <div class="build-cards-column">
        <div class="build-cards-stack" data-build-stack>
          {buildCapabilities.map((item, i) => (
            <article
              class="build-rectangle"
              data-build-card
              data-build-index={i}
              data-build-number={String(i + 1).padStart(2, '0')}
              data-build-category={item.category}
              data-build-name={item.name}
              data-build-description={item.description}
            >
              <div class="build-card-image">
                <img
                  src={item.image}
                  alt={item.alt}
                  loading={i < 1 ? 'eager' : 'lazy'}
                  decoding="async"
                  width="1400"
                  height="1000"
                />

                <div class="build-card-image-shade"></div>

                <div class="build-card-number">{String(i + 1).padStart(2, '0')}</div>
              </div>

              <div class="build-card-content">
                <span class="build-card-topline">{item.category}</span>

                <h3 class="build-card-title">{item.name}</h3>

                <p class="build-card-copy">{item.description}</p>

                <div class="build-card-footer">
                  <span>View capability</span>
                  <span class="build-card-arrow">↗</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>


  </div>

</section>


<!-- =========================================================
     SECTION 03B — CAPABILITIES CTA
     One merged, dark section: the "team" statement, a clear
     primary CTA to /services/, and the full crawlable service
     index — replaces the old subtle text-link + bare nav pair.
========================================================== -->

<section
  id="capabilities"
  class="capabilities-cta relative overflow-clip bg-ink text-paper py-20 md:py-28"
  aria-labelledby="capabilities-title"
>

  <div class="capabilities-grid absolute inset-0" aria-hidden="true"></div>

  <div class="wrap relative z-[2]">

    <!-- =====================================================
         STATEMENT + CLEAR CTA
    ====================================================== -->

    <div class="flex flex-col gap-8 border-b border-paper/15 pb-12 md:flex-row md:items-end md:justify-between md:gap-10">

      <p
        id="capabilities-title"
        class="max-w-[650px] font-serif text-[28px] leading-[1.15] tracking-[-.02em] md:text-[36px]"
      >
        One team from the first idea
        <span class="text-paper/40">to the finished environment.</span>
      </p>

      <a
        href="/services/"
        class="capabilities-cta-btn group relative inline-flex shrink-0 items-center gap-6 overflow-hidden border border-paper/30 px-7 py-5"
        data-analytics-event="click_explore_capabilities"
        data-analytics-params={JSON.stringify({ placement: 'homepage_build_section' })}
      >

        <span class="relative z-[2] font-mono text-[12px] uppercase tracking-[.18em]">
          Explore our capabilities
        </span>

        <span class="relative z-[2] text-[18px] transition-transform duration-500 group-hover:translate-x-2">
          →
        </span>

        <span class="capabilities-cta-fill absolute inset-0 origin-left scale-x-0 bg-accent transition-transform duration-500 ease-out group-hover:scale-x-100"></span>

      </a>

    </div>


    <!-- =====================================================
         FULL SERVICE INDEX — crawlable links to every service page
    ====================================================== -->

    <nav aria-label="All construction services" class="mt-12">

      <span class="font-mono text-[12px] uppercase tracking-[.2em] text-paper/40">
        Every service PBJ Infra offers
      </span>

      <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
        {primaryServices.map((s) => (
          <li>
            <a href={s.url} class="group inline-flex items-center gap-2 font-serif text-[17px] tracking-[-.01em] text-paper/80 hover:text-paper">
              {s.name}
              <span class="font-mono text-accent transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </li>
        ))}
      </ul>

    </nav>

  </div>

</section>


<style>

  .capabilities-cta {
    isolation: isolate;
  }

  .capabilities-grid {

    opacity: .035;

    background-image:
      linear-gradient(rgba(246, 243, 236, .4) 1px, transparent 1px),
      linear-gradient(90deg, rgba(246, 243, 236, .4) 1px, transparent 1px);

    background-size: 80px 80px;

    mask-image:
      linear-gradient(to bottom, transparent, black 20%, black 85%, transparent);
  }

  .capabilities-cta-btn {

    isolation: isolate;

    transition:
      border-color .35s ease,
      color .35s ease;
  }

  .capabilities-cta-btn:hover {

    border-color: rgb(30,110,100);

    color: white;
  }

  .capabilities-cta-fill {

    z-index: 0;
  }

  @media (max-width: 640px) {

    .capabilities-grid {

      background-size: 55px 55px;
    }

    .capabilities-cta-btn {

      width: 100%;

      justify-content: space-between;
    }

  }

  @media (prefers-reduced-motion: reduce) {

    .capabilities-cta-fill {

      transition: none !important;
    }

  }

</style>


<style>

  /* ==========================================================
     BACKGROUND
  ========================================================== */

  .build-section {
    isolation: isolate;
  }

  .build-bg-grid {

    opacity: .045;

    background-image:
      linear-gradient(
        rgba(20,23,26,.5) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(20,23,26,.5) 1px,
        transparent 1px
      );

    background-size:
      80px 80px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 20%,
        black 80%,
        transparent
      );
  }


  /* ==========================================================
     CAPABILITY SHOWCASE — sticky left panel, scrolling right
     column. Same mechanic as .projects-showcase on /projects/.
  ========================================================== */

  .build-showcase {

    display: grid;

    grid-template-columns:
      minmax(220px, .62fr) minmax(0, 1.38fr);

    gap: clamp(2.5rem, 6vw, 5rem);

    align-items: stretch;
  }


  .build-panel {

    min-width: 0;

    align-self: stretch;

    padding-left: clamp(1.5rem, 3vw, 2.5rem);

    border-left: 1px solid rgba(20,23,26,.09);
  }


  .build-sticky {

    position: sticky;

    top: 7rem;

    min-height: calc(100vh - 7rem);

    padding: 2.5rem 0 3rem;

    display: flex;

    flex-direction: column;
  }


  .build-number-wrap {

    display: flex;

    align-items: center;

    gap: 1rem;
  }


  .build-number-current {

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 12px;

    font-weight: 600;

    letter-spacing: .16em;

    color: rgb(30,110,100);
  }


  .build-number-line {

    width: 3rem;

    height: 1px;

    background: rgba(30,110,100,.35);
  }


  .build-label {

    margin-top: 3rem;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size: 10px;

    letter-spacing: .22em;

    text-transform: uppercase;

    color: rgba(20,23,26,.35);
  }


  .build-panel-title {

    max-width: 20rem;

    margin-top: .9rem;

    font-family:
      Georgia,
      serif;

    font-size: clamp(2rem, 3.4vw, 3rem);

    font-weight: 500;

    line-height: .98;

    letter-spacing: -.04em;

    transition:
      opacity .25s ease,
      transform .35s cubic-bezier(.2,.65,.25,1);
  }


  .build-panel-description {

    max-width: 20rem;

    margin-top: 1.1rem;

    font-size: 13px;

    line-height: 1.7;

    color: rgba(20,23,26,.48);

    transition:
      opacity .25s ease,
      transform .35s cubic-bezier(.2,.65,.25,1);
  }


  .build-meta {

    display: flex;

    align-items: center;

    gap: .8rem;

    margin-top: 1.75rem;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
