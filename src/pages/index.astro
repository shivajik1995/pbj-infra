========================================================== -->

<section
  id="contact"
  class="final-cta relative min-h-[85svh] overflow-hidden bg-ink text-paper"
  aria-labelledby="cta-title"
>

  <!-- =====================================================
       VISUAL BACKGROUND
  ====================================================== -->

  <div
    class="cta-visual absolute inset-0"
    aria-hidden="true"
  >

    <img
      src="https://pbjinfra.com/assets/images/resort.jpg"
      alt=""
      loading="lazy"
      width="1800"
      height="1200"
      class="cta-image absolute inset-0 h-full w-full object-cover"
    />

    <div class="absolute inset-0 bg-ink/65"></div>

    <div
      class="absolute inset-0 bg-gradient-to-b from-ink/30 via-ink/50 to-ink"
    ></div>

  </div>


  <!-- =====================================================
       ARCHITECTURAL GRID
  ====================================================== -->

  <div
    class="cta-grid absolute inset-0"
    aria-hidden="true"
