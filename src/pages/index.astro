---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CinematicHero from '../components/CinematicHero.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { whatsappLink, telLink, mailtoLink } from '../lib/site';
import { faqSchema, serviceItemListSchema } from '../lib/schema';
import { getGoogleReviews } from '../lib/googleReviews';

// Primary service pages — drives the homepage "What We Build" links and the
// ItemList structured data. Keep in sync with src/content/services/.
const primaryServices = [
  { name: 'Swimming Pool Construction', url: '/services/swimming-pool-construction/' },
  { name: 'Pool Filtration Systems', url: '/services/pool-filtration-systems/' },
  { name: 'Pool Tiling & Finishing', url: '/services/swimming-pool-tiles/' },
  { name: 'Lagoon Pool Construction', url: '/services/lagoon-pool-construction/' },
  { name: 'Waterpark Construction', url: '/services/waterpark-construction/' },
  { name: 'Resort Construction', url: '/services/resort-construction/' },
  { name: 'Farmhouse Construction', url: '/services/farmhouse-construction/' },
  { name: 'Cob House Construction', url: '/services/cob-house-construction/' },
  { name: 'Ferro Concrete Design', url: '/services/ferro-concrete-design/' },
  { name: 'Ferrocement Dome', url: '/services/ferrocement-dome/' },
  { name: 'Land Development', url: '/services/land-development/' },
];

// Developers whose projects PBJ Infra has worked with, per pbjinfra.com's
// own clients section. Names only — not styled as endorsements or reviews.
const developers = [
  'Panchshil Realty',
  'Godrej Properties',
  'Nyati Group',
  'Kolte Patil Developers',
  'Majestique Landmarks',
  'Ajmera Group',
  'Mahindra Lifespaces',
  'D.Y. Patil',
];

const projects = await getCollection('projects');
const projectOrder = ['adventure-waterpark-latur', 'luxury-infinity-pool', 'rabbit-dome-house', 'natural-lagoon-pool',
'farm-house-latur'];
const orderedProjects = projectOrder.map((slug) => projects.find((p) => p.slug === slug)!).filter(Boolean);

const faqSlugs = ['pool-timeline', 'warranty', 'permits', 'design-and-build', 'cost'];
const faqs = await Promise.all(faqSlugs.map((id) => getEntry('faq', id)));
const faqItems = faqs.filter(Boolean).map((f) => f!.data);

// Google reviews — real, build-time data only (see lib/googleReviews.ts).
// `available: false` (unset API env vars, or a failed fetch) renders the
// honest "pending connection" state below — never a fabricated rating or
// invented review text.
const googleReviews = await getGoogleReviews();
const gRatingDisplay = googleReviews.available && googleReviews.rating != null ? googleReviews.rating.toFixed(1) : '—.—';
const gRoundedRating = Math.round(googleReviews.rating ?? 0);
const gStars = googleReviews.available ? '★'.repeat(gRoundedRating) + '☆'.repeat(5 - gRoundedRating) : '★★★★★';
const gCountDisplay = googleReviews.available
  ? `${googleReviews.userRatingCount ?? 0} Google reviews`
  : 'Google rating · pending connection';
const gProfileUrl = googleReviews.profileUrl ?? 'https://www.google.com/maps/search/?api=1&query=PBJ+Infra';
const gReviews = googleReviews.available ? (googleReviews.reviews ?? []).slice(0, 3) : [];
---
<BaseLayout title="Construction Company in Pune & Latur | PBJ Infra"
  description="PBJ Infra builds swimming pools, waterparks, resorts, farmhouses and specialised structures across Pune, Latur and Maharashtra. Operating since 2009."
  path="/" schema={[serviceItemListSchema(primaryServices), faqSchema(faqItems)]}>
  <!-- ============ HERO ============ -->
  <CinematicHero />


  <!-- ============ SIGNATURE PROJECTS ============ -->

  <section id="projects" class="projects-showcase relative overflow-hidden bg-ink text-paper py-24 md:py-36"
    aria-labelledby="projects-title">

    <!-- Background technical grid -->

    <div class="projects-grid absolute inset-0" aria-hidden="true"></div>


    <!-- Ambient glow -->

    <div class="projects-glow absolute inset-0" aria-hidden="true"></div>


    <div class="wrap relative z-[2]">


      <!-- =====================================================
         SECTION HEADER
    ====================================================== -->

      <div class="projects-header flex flex-col items-center py-10 text-center md:py-16">

        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-accent"></span>
          <span class="font-mono text-[9px] uppercase tracking-[.24em] text-paper/45">
            02 / Signature Projects
          </span>
          <span class="h-px w-8 bg-accent"></span>
        </div>

        <h2 id="projects-title"
          class="projects-title mx-auto mt-7 max-w-[16ch] font-serif text-[clamp(42px,6vw,82px)] leading-[.92] tracking-[-.04em]">
          Built environments,
          <span class="text-paper/45">
            not just structures.
          </span>
        </h2>

        <p class="projects-intro mx-auto mt-7 max-w-[600px] text-[14px] leading-[1.75] text-paper/55 md:text-[15px]">
          From immersive aquatic spaces to destination hospitality and
          one-of-a-kind residential structures, every PBJ project is
          engineered around the way it will actually be experienced.
        </p>

      </div>


      <!-- =====================================================
         PROJECT LIST
    ====================================================== -->

      <div class="projects-list mt-20 md:mt-28">

        {orderedProjects.map((p, i) => {
          const isPublished = p.data.status === 'published';
          const href = isPublished ? `/projects/${p.slug}/` : '/projects/';
          return (
            <a href={href}
              class="project-item group grid gap-7 border-t border-paper/[.14] py-10 md:grid-cols-[80px_1fr_1.2fr_100px] md:items-center md:py-14">

              <div class="project-number font-mono text-[10px] text-paper/30">
                {String(i + 1).padStart(2, '0')}
              </div>

              <div>

                <span class="project-category font-mono text-[9px] uppercase tracking-[.16em] text-accent">
                  {p.data.projectType}
                </span>

                <h3 class="project-name mt-3 font-serif text-[30px] leading-none tracking-[-.025em] md:text-[40px]">
                  {p.data.name}
                </h3>

                <p class="project-location mt-3 font-mono text-[9px] uppercase tracking-[.12em] text-paper/35">
                  {p.data.location}
                </p>

              </div>

              <!-- Image -->

              <div class="project-image-wrap relative aspect-[16/9] overflow-hidden bg-paper/5">

                <img src={p.data.heroImage.src} alt={p.data.heroImage.alt}
                  loading="lazy" decoding="async" width="1200" height="675" class="project-image h-full w-full object-cover" />

                <div class="absolute inset-0 bg-black/10 transition duration-700 group-hover:bg-black/0"></div>

                <!-- technical frame -->

                <div class="project-frame absolute inset-4 border border-paper/20"></div>

                <!-- Hover label -->

                <div class="project-hover absolute bottom-5 left-5 flex items-center gap-3">

                  <span
                    class="flex h-9 w-9 items-center justify-center rounded-full border border-paper/35 bg-black/20 backdrop-blur-sm">
                    →
                  </span>

                  <span class="font-mono text-[9px] uppercase tracking-[.15em]">
                    {isPublished ? 'View project' : 'Case study in development'}
                  </span>

                </div>

              </div>

              <div class="hidden justify-self-end md:block">

                <span class="project-arrow font-mono text-xl text-paper/30">
                  ↗
                </span>

              </div>

            </a>
          );
        })}

      </div>


      <!-- =====================================================
         ALL PROJECTS CTA
    ====================================================== -->

      <div class="projects-footer flex justify-between items-center pt-10">

        <span class="font-mono text-[9px] uppercase tracking-[.16em] text-paper/30">
          Selected PBJ work
        </span>

        <a href="/projects/"
          class="projects-all group flex items-center gap-3 font-mono text-[10px] uppercase tracking-[.15em]">

          <span>
            Explore all projects
          </span>

          <span class="transition-transform duration-300 group-hover:translate-x-1">
            →
          </span>

        </a>

      </div>

    </div>

  </section>


  <style>
    /* ==========================================================
     BACKGROUND
  ========================================================== */

    .projects-showcase {
      isolation: isolate;
    }


    .projects-grid {

      opacity: .045;

      background-image:
        linear-gradient(rgba(246, 243, 236, .35) 1px,
          transparent 1px),
        linear-gradient(90deg,
          rgba(246, 243, 236, .35) 1px,
          transparent 1px);

      background-size:
        80px 80px;

      mask-image:
        linear-gradient(to bottom,
          transparent,
          black 15%,
          black 80%,
          transparent);
    }


    .projects-glow {

      background:
        radial-gradient(circle at 75% 30%,
          rgba(30, 110, 100, .12),
          transparent 30%);
    }


    /* ==========================================================
     PROJECT IMAGE
  ========================================================== */

    .project-image-wrap {

      transform:
        translateZ(0);

      overflow:
        hidden;
    }


    .project-image {

      transform:
        scale(1.04);

      filter:
        saturate(.78) contrast(1.04);

      transition:
        transform 1s cubic-bezier(.2, .7, .2, 1),
        filter 700ms ease;

      will-change:
        transform;
    }


    .project-item:hover .project-image {

      transform:
        scale(1.09);

      filter:
        saturate(.95) contrast(1.02);
    }


    /* ==========================================================
     FRAME
  ========================================================== */

    .project-frame {

      transform:
        scale(.96);

      opacity:
        .35;

      transition:
        transform .8s cubic-bezier(.2, .7, .2, 1),
        opacity .5s ease;
    }


    .project-item:hover .project-frame {

      transform:
        scale(1);

      opacity:
        .75;
    }


    /* ==========================================================
     HOVER ARROW
  ========================================================== */

    .project-arrow {

      transition:
        transform .4s cubic-bezier(.2, .7, .2, 1),
        color .3s ease;
    }


    .project-item:hover .project-arrow {

      transform:
        translate(4px, -4px);

      color:
        rgba(246, 243, 236, .9);
    }


    /* ==========================================================
     PROJECT TEXT
  ========================================================== */

    .project-name {

      transition:
        transform .45s cubic-bezier(.2, .7, .2, 1);
    }


    .project-item:hover .project-name {

      transform:
        translateX(7px);
    }


    .project-hover {

      opacity:
        .75;

      transition:
        opacity .35s ease,
        transform .45s cubic-bezier(.2, .7, .2, 1);

      transform:
        translateY(5px);
    }


    .project-item:hover .project-hover {

      opacity:
        1;

      transform:
        translateY(0);
    }


    /* ==========================================================
     MOBILE
  ========================================================== */

    @media (max-width: 768px) {

      .projects-grid {

        background-size:
          55px 55px;
      }

      .project-image-wrap {

        aspect-ratio:
          16 / 10;
      }

    }


    /* ==========================================================
     REDUCED MOTION
  ========================================================== */

    @media (prefers-reduced-motion: reduce) {

      .project-image,
      .project-frame,
      .project-name,
      .project-hover {

        transition:
          none !important;

        transform:
          none !important;
      }

    }
  </style>


  <!-- ============ WHAT WE BUILD ============ -->
  <!-- =========================================================
     SECTION 03 — WHAT WE BUILD
========================================================== -->

<section
  id="services"
  class="build-section relative overflow-hidden bg-paper text-ink py-24 md:py-36"
  aria-labelledby="build-title"
>

  <div class="build-bg-grid absolute inset-0" aria-hidden="true"></div>


  <div class="wrap relative z-[2]">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="build-header flex flex-col items-center py-10 text-center md:py-16">

      <div class="flex items-center gap-3">
        <span class="h-px w-8 bg-accent"></span>
        <span class="font-mono text-[9px] uppercase tracking-[.24em] text-ink/45">
          03 / What We Build
        </span>
        <span class="h-px w-8 bg-accent"></span>
      </div>

      <h2
        id="build-title"
        class="build-title mx-auto mt-7 max-w-[16ch] font-serif text-[clamp(44px,6vw,82px)] leading-[.92] tracking-[-.045em]"
      >
        Spaces with a purpose.
        <span class="text-ink/35">
          Built with precision.
        </span>
      </h2>

      <p class="build-intro mx-auto mt-7 max-w-[600px] text-[14px] leading-[1.75] text-ink/55 md:text-[15px]">
        PBJ combines construction expertise, engineering discipline and
        practical execution to create environments that are made to last.
      </p>

    </div>


    <!-- =====================================================
         INTERACTIVE BUILD INDEX
    ====================================================== -->

    <div
      class="build-interface mt-20 grid gap-10 lg:grid-cols-[.8fr_1.5fr]"
    >


      <!-- ===================================================
           CATEGORY LIST
      ==================================================== -->

      <div
        class="build-list"
        role="list"
      >


        <!-- ITEM 01 -->

        <button
          type="button"
          class="build-item is-active group"
          data-build="aquatic"
          role="listitem"
          aria-pressed="true"
        >

          <span class="build-number">
            01
          </span>


          <span class="build-item-content">

            <span class="build-category">
              Aquatic
            </span>

            <span class="build-name">
              Swimming Pools
            </span>

            <span class="build-description">
              From private pools to destination-scale aquatic environments.
            </span>

          </span>


          <span class="build-item-arrow">
            ↗
          </span>

        </button>


        <!-- ITEM 02 -->

        <button
          type="button"
          class="build-item group"
          data-build="hospitality"
          role="listitem"
          aria-pressed="false"
        >

          <span class="build-number">
            02
          </span>


          <span class="build-item-content">

            <span class="build-category">
              Hospitality
            </span>

            <span class="build-name">
              Resorts & Destinations
            </span>

            <span class="build-description">
              Built environments designed around experience, flow and place.
            </span>

          </span>


          <span class="build-item-arrow">
            ↗
          </span>

        </button>


        <!-- ITEM 03 -->

        <button
          type="button"
          class="build-item group"
          data-build="recreation"
          role="listitem"
          aria-pressed="false"
        >

          <span class="build-number">
            03
          </span>


          <span class="build-item-content">

            <span class="build-category">
              Recreation
            </span>

            <span class="build-name">
              Waterparks
            </span>

            <span class="build-description">
              Complex aquatic infrastructure engineered for high-use environments.
            </span>

          </span>


          <span class="build-item-arrow">
            ↗
          </span>

        </button>


        <!-- ITEM 04 -->

        <button
          type="button"
          class="build-item group"
          data-build="specialized"
          role="listitem"
          aria-pressed="false"
        >

          <span class="build-number">
            04
          </span>


          <span class="build-item-content">

            <span class="build-category">
              Specialized
            </span>

            <span class="build-name">
              Bespoke Structures
            </span>

            <span class="build-description">
              Custom structural solutions for projects that don't fit a template.
            </span>

          </span>


          <span class="build-item-arrow">
            ↗
          </span>

        </button>


      </div>


      <!-- ===================================================
           VISUAL STAGE
      ==================================================== -->

      <div class="build-stage relative min-h-[460px] overflow-hidden bg-ink md:min-h-[600px]">

        <!-- IMAGE 01 -->

        <div
          class="build-visual is-active"
          data-visual="aquatic"
        >

          <img
            src="https://pbjinfra.com/assets/images/swimming-pool.jpg"
            alt="A completed swimming pool with mosaic tiling, built by PBJ Infra"
            loading="lazy"
            decoding="async"
            width="1400"
            height="1000"
          />

        </div>


        <!-- IMAGE 02 -->

        <div
          class="build-visual"
          data-visual="hospitality"
        >

          <img
            src="https://pbjinfra.com/assets/images/resort.jpg"
            alt="A resort building beside a landscaped pool, built by PBJ Infra"
            loading="lazy"
            decoding="async"
            width="1400"
            height="1000"
          />

        </div>


        <!-- IMAGE 03 -->

        <div
          class="build-visual"
          data-visual="recreation"
        >

          <img
            src="https://pbjinfra.com/assets/images/waterpark-construction-services.jpg"
            alt="Waterpark slides and attraction pools built by PBJ Infra"
            loading="lazy"
            decoding="async"
            width="1400"
            height="1000"
          />

        </div>


        <!-- IMAGE 04 -->

        <div
          class="build-visual"
          data-visual="specialized"
        >

          <img
            src="https://pbjinfra.com/assets/images/DOM.jpeg"
            alt="A curved ferrocement dome structure built by PBJ Infra"
            loading="lazy"
            decoding="async"
            width="1400"
            height="1000"
          />

        </div>


        <!-- Visual overlay -->

        <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-black/10"></div>


        <!-- Technical frame -->

        <div class="build-frame absolute inset-5 border border-paper/25 md:inset-7"></div>


        <!-- Image metadata -->

        <div class="absolute left-7 top-7 z-[4]">

          <span class="font-mono text-[8px] uppercase tracking-[.2em] text-paper/50">
            PBJ INFRA / BUILT ENVIRONMENT
          </span>

        </div>


        <!-- Bottom label -->

        <div class="build-stage-label absolute bottom-7 left-7 right-7 z-[4] flex items-end justify-between">

          <div>

            <span
              id="build-stage-category"
              class="font-mono text-[9px] uppercase tracking-[.2em] text-accent"
            >
              Aquatic
            </span>

            <div
              id="build-stage-title"
              class="mt-2 font-serif text-[34px] leading-none text-paper md:text-[48px]"
            >
              Swimming Pools
            </div>

          </div>


          <div class="font-mono text-[9px] text-paper/45">
            01 / 04
          </div>

        </div>

      </div>

    </div>


    <!-- =====================================================
         BOTTOM STATEMENT
    ====================================================== -->

    <div
      class="build-footer mt-16 flex flex-col gap-5 border-t border-ink/15 pt-7 md:flex-row md:items-center md:justify-between"
    >

      <p class="max-w-[650px] font-serif text-[22px] leading-[1.15] tracking-[-.02em] md:text-[28px]">
        One team from the first idea
        <span class="text-ink/35">to the finished environment.</span>
      </p>


      <a
        href="/services/"
        class="group flex items-center gap-3 font-mono text-[9px] uppercase tracking-[.16em]"
      >

        <span>
          Explore our capabilities
        </span>

        <span class="transition-transform duration-300 group-hover:translate-x-1">
          →
        </span>

      </a>

    </div>


    <!-- =====================================================
         FULL SERVICE INDEX — crawlable links to every service page
    ====================================================== -->

    <nav aria-label="All construction services" class="build-services mt-14 border-t border-ink/15 pt-8">

      <span class="font-mono text-[9px] uppercase tracking-[.2em] text-ink/40">
        Every service PBJ Infra offers
      </span>

      <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
        {primaryServices.map((s) => (
          <li>
            <a href={s.url} class="group inline-flex items-center gap-2 font-serif text-[17px] tracking-[-.01em] text-ink/80 hover:text-ink">
              {s.name}
              <span class="font-mono text-accent transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </li>
        ))}
      </ul>

    </nav>

  </div>

</section>


<style>

  /* ==========================================================
     BACKGROUND
  ========================================================== */

  .build-section {
    isolation: isolate;
  }

  .build-bg-grid {

    opacity: .045;

    background-image:
      linear-gradient(
        rgba(20,23,26,.5) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(20,23,26,.5) 1px,
        transparent 1px
      );

    background-size:
      80px 80px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 20%,
        black 80%,
        transparent
      );
  }


  /* ==========================================================
     BUILD ITEMS
  ========================================================== */

  .build-item {

    position: relative;

    display: grid;

    grid-template-columns:
      35px 1fr 25px;

    gap: 18px;

    width: 100%;

    padding:
      25px 0;

    text-align: left;

    border-top:
      1px solid rgba(20,23,26,.14);

    cursor: pointer;

    transition:
      opacity .3s ease;
  }


  .build-item:last-child {

    border-bottom:
      1px solid rgba(20,23,26,.14);
  }


  .build-item:not(.is-active) {

    opacity:
      .42;
  }


  .build-item:hover,
  .build-item.is-active {

    opacity:
      1;
  }


  .build-number {

    padding-top:
      4px;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size:
      9px;

    color:
      rgba(20,23,26,.35);
  }


  .build-item-content {

    display:
      flex;

    flex-direction:
      column;
  }


  .build-category {

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size:
      8px;

    text-transform:
      uppercase;

    letter-spacing:
      .18em;

    color:
      rgb(30,110,100);
  }


  .build-name {

    margin-top:
      7px;

    font-family:
      Georgia,
      serif;

    font-size:
      clamp(24px,3vw,36px);

    line-height:
      .95;

    letter-spacing:
      -.025em;
  }


  .build-description {

    max-width:
      430px;

    margin-top:
      9px;

    font-size:
      12px;

    line-height:
      1.6;

    color:
      rgba(20,23,26,.48);
  }


  .build-item-arrow {

    align-self:
      center;

    font-size:
      18px;

    color:
      rgba(20,23,26,.3);

    transition:
      transform .4s cubic-bezier(.2,.7,.2,1),
      color .3s ease;
  }


  .build-item:hover
  .build-item-arrow,
  .build-item.is-active
  .build-item-arrow {

    transform:
      translate(3px,-3px);

    color:
      rgb(30,110,100);
  }


  /* ==========================================================
     VISUAL STAGE
  ========================================================== */

  .build-stage {

    isolation: isolate;
  }


  .build-visual {

    position:
      absolute;

    inset:
      0;

    opacity:
      0;

    visibility:
      hidden;
  }


  .build-visual.is-active {

    opacity:
      1;

    visibility:
      visible;
  }


  .build-visual img {

    width:
      100%;

    height:
      100%;

    object-fit:
      cover;

    filter:
      saturate(.78)
      contrast(1.05);

    transform:
      scale(1.04);

    transition:
      transform 1.2s cubic-bezier(.2,.7,.2,1);
  }


  .build-visual.is-active img {

    transform:
      scale(1);
  }


  .build-frame {

    z-index:
      3;

    pointer-events:
      none;
  }


  /* ==========================================================
     MOBILE
  ========================================================== */

  @media (max-width: 1023px) {

    .build-interface {

      grid-template-columns:
        1fr;
    }

    .build-stage {

      min-height:
        480px;
    }

  }


  @media (max-width: 640px) {

    .build-bg-grid {

      background-size:
        55px 55px;
    }

    .build-item {

      padding:
        20px 0;
    }

    .build-description {

