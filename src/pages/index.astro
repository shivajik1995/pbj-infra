<style>

  /* ==========================================================
     CTA VISUAL
  ========================================================== */

  .final-cta {
    isolation: isolate;
  }


  .cta-image {

    opacity:
      .72;

    filter:
      saturate(.55)
      contrast(1.1);

    transform:
      scale(1.08);

    transition:
      transform 1.5s cubic-bezier(.2,.7,.2,1);
  }


  .final-cta:hover .cta-image {

    transform:
      scale(1.03);
  }


  /* ==========================================================
     GRID
  ========================================================== */

  .cta-grid {

    opacity:
      .045;

    background-image:
      linear-gradient(
        rgba(246,243,236,.6) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(246,243,236,.6) 1px,
        transparent 1px
      );

    background-size:
      90px 90px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 20%,
        black 80%,
        transparent
      );
  }


  /* ==========================================================
     CTA BUTTON
  ========================================================== */

  .cta-button {

    isolation:
      isolate;

    transition:
      border-color .35s ease,
      color .35s ease;
  }


  .cta-button:hover {

    border-color:
      rgb(30,110,100);

    color:
      white;
  }


  .cta-button-fill {

    z-index:
      0;

  }


  /* ==========================================================
     CONTACT LINKS
  ========================================================== */

  .cta-contact {

    display:
      inline-flex;

    align-items:
      center;

    gap:
      9px;

    padding-bottom:
      7px;

    border-bottom:
      1px solid rgba(246,243,236,.2);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;

    font-size:
      9px;

    text-transform:
      uppercase;

    letter-spacing:
      .15em;

    color:
      rgba(246,243,236,.55);

    transition:
      color .3s ease,
      border-color .3s ease;
  }


  .cta-contact:hover {

    color:
      rgb(246,243,236);

    border-color:
      rgb(30,110,100);
  }


  /* ==========================================================
     MOBILE
  ========================================================== */

  @media (max-width: 640px) {

    .cta-grid {

      background-size:
        55px 55px;
    }

    .cta-copy {

      max-width:
        340px;
    }

    .cta-button {

      width:
        100%;

      justify-content:
        space-between;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    .cta-image,
    .cta-button-fill {

      transition:
        none !important;
    }

    .final-cta:hover .cta-image {

      transform:
        scale(1.08);
    }

  }

</style>


<script>

  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(
    ScrollTrigger
  );


  const cta =
    document.querySelector<HTMLElement>(
      '.final-cta'
    );


  if (cta) {

    const reduceMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;


    if (!reduceMotion) {

      const image =
        cta.querySelector(
          '.cta-image'
        );


      const title =
        cta.querySelector(
          '.cta-title'
        );


      const copy =
        cta.querySelector(
          '.cta-copy'
        );


      const button =
        cta.querySelector(
          '.cta-button'
        );


      gsap.fromTo(
        image,

        {
          y: -35
        },

        {
          y: 35,
          ease: 'none',

          scrollTrigger: {

            trigger:
              cta,

            start:
              'top bottom',

            end:
              'bottom top',

            scrub:
              1.2

          }

        }
      );


      gsap.fromTo(
        [title, copy, button],

        {
          y: 45,
          opacity: 0
        },

        {
          y: 0,
          opacity: 1,
          duration: .9,
          stagger: .12,
          ease: 'power3.out',

          scrollTrigger: {

            trigger:
              cta,

            start:
              'top 70%',

            once:
              true

          }

        }
      );

    }

  }

</script>
</BaseLayout>