<script>

  /*
   * Real Google reviews, fetched build-time in the page frontmatter
   * (see lib/googleReviews.ts) and handed to this script via the
   * `#google-reviews-data` JSON island below — never hardcoded/fabricated
   * here. Empty array = not connected yet, or zero reviews returned; the
   * static HTML already renders the honest "pending connection" state for
   * that case, so this script simply does nothing.
   */

  const dataEl = document.getElementById('google-reviews-data');
  const reviews = dataEl?.textContent ? JSON.parse(dataEl.textContent) : [];

  const reviewText =
    document.querySelector<HTMLElement>(
      '#review-text'
    );

  const reviewAuthor =
    document.querySelector<HTMLElement>(
      '#review-author'
    );

  const reviewSource =
    document.querySelector<HTMLElement>(
      '#review-source'
    );

  const reviewCounter =
    document.querySelector<HTMLElement>(
      '#review-counter'
    );

  const reviewContent =
    document.querySelector<HTMLElement>(
      '.review-content'
    );

  const dots =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        '.review-dot'
      )
    );


  let currentReview = 0;


  const showReview =
    (index: number) => {

      const review =
        reviews[index];

      if (!review) return;


      reviewContent?.classList.add(
        'is-changing'
      );


      window.setTimeout(
        () => {

          if (reviewText)
            reviewText.textContent =
              review.text;

          if (reviewAuthor)
            reviewAuthor.textContent =
              review.authorName;

          if (reviewSource)
            reviewSource.textContent =
              'Google Review';

          if (reviewCounter)
            reviewCounter.textContent =
              `${String(index + 1).padStart(2, '0')} / ${String(reviews.length).padStart(2, '0')}`;


          dots.forEach(
            (dot, dotIndex) => {

              dot.classList.toggle(
                'is-active',
                dotIndex === index
              );

            }
          );


          reviewContent?.classList.remove(
            'is-changing'
          );

        },
        250
      );


      currentReview =
        index;

    };


  // Auto-rotation and dot navigation only make sense with more than one
  // real review — with 0 or 1, the static markup already shows everything
  // there is to show, so skip wiring up interactivity entirely.
  if (reviews.length > 1) {

    dots.forEach(
      (dot) => {

        dot.addEventListener(
          'click',
          () => {

            const index =
              Number(
                dot.dataset.review
              );

            showReview(index);

          }
        );

      }
    );


    /*
     * Slow auto rotation.
     *
     * We intentionally keep this subtle.
     */

    const reduceMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;


    if (!reduceMotion) {

      window.setInterval(
        () => {

          showReview(
            (currentReview + 1) % reviews.length
          );

        },
        7000
      );

    }

  }

</script>

