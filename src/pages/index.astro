<script>
  const processRoot = document.querySelector('#process');

  if (processRoot) {
    const panels = Array.from(
      processRoot.querySelectorAll('[data-process-step]')
    );

    const navItems = Array.from(
      processRoot.querySelectorAll('[data-process-nav]')
    );

    const number = processRoot.querySelector(
      '[data-process-number]'
    );

    const title = processRoot.querySelector(
      '[data-process-title]'
    );

    const description = processRoot.querySelector(
      '[data-process-description]'
    );

    let activeStep = '01';


    function setActiveStep(step) {
      if (step === activeStep) return;

      activeStep = step;

      const panel = panels.find(
        (item) =>
          item.dataset.processStep === step
      );

      if (!panel) return;

      panels.forEach((item) => {
        item.classList.toggle(
          'is-active',
          item === panel
        );
      });

      navItems.forEach((item) => {
        item.classList.toggle(
          'is-active',
          item.dataset.processNav === step
        );
      });

      if (number) {
        number.textContent = step;
      }

      if (title) {
        title.style.opacity = '0';
        title.style.transform = 'translateY(8px)';

        window.setTimeout(() => {
          title.textContent =
            panel.dataset.title || '';

          title.style.opacity = '1';
          title.style.transform =
            'translateY(0)';
        }, 120);
      }

      if (description) {
        description.style.opacity = '0';
        description.style.transform =
          'translateY(8px)';

        window.setTimeout(() => {
          description.textContent =
            panel.dataset.description || '';

          description.style.opacity = '1';
          description.style.transform =
            'translateY(0)';
        }, 120);
      }
    }


    /*
     * Detect the panel closest to the viewport
     * center and activate it.
     */

    const observer = new IntersectionObserver(
      (entries) => {

        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) =>
              Math.abs(
                a.boundingClientRect.top -
                window.innerHeight * .42
              ) -
              Math.abs(
                b.boundingClientRect.top -
                window.innerHeight * .42
              )
          );

        if (visible.length) {
          setActiveStep(
            visible[0]
              .target
              .dataset
              .processStep
          );
        }
      },
      {
        threshold: [0.15, 0.35, 0.55],
        rootMargin: '-18% 0px -42% 0px'
      }
    );


    panels.forEach((panel) => {
      observer.observe(panel);
    });


    /*
     * Navigation click
     */

    navItems.forEach((item) => {

      item.addEventListener(
        'click',
        (event) => {

          const href =
            item.getAttribute('href');

          if (!href) return;

          const target =
            document.querySelector(href);

          if (!target) return;

          event.preventDefault();

          target.scrollIntoView({
            behavior:
              window.matchMedia(
                '(prefers-reduced-motion: reduce)'
              ).matches
                ? 'auto'
                : 'smooth',
            block: 'start'
          });

        }
      );

    });


    /*
     * First step should be active immediately.
     */

    const firstPanel = panels[0];

    if (firstPanel) {
      firstPanel.classList.add('is-active');

      if (number) {
        number.textContent = '01';
      }

      if (title) {
        title.textContent =
          firstPanel.dataset.title || 'Understand';
      }

      if (description) {
        description.textContent =
          firstPanel.dataset.description || '';
      }
    }
  }
</script>


