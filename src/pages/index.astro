<script>

  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';


  gsap.registerPlugin(
    ScrollTrigger
  );


  const processSection =
    document.querySelector<HTMLElement>(
      '.process-section'
    );


  if (processSection) {

    const steps =
      Array.from(
        processSection.querySelectorAll<HTMLElement>(
          '.process-step'
        )
      );


    const progress =
      processSection.querySelector<HTMLElement>(
        '.process-progress'
      );


    const reduceMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;


    if (!reduceMotion) {

      /*
       * Draw the vertical timeline as the user scrolls.
       */

      if (progress) {

        gsap.to(
          progress,
          {
            height: '100%',
            ease: 'none',

            scrollTrigger: {

              trigger:
                processSection,

              start:
                'top 55%',

              end:
                'bottom 65%',

              scrub:
                0.8

            }

          }
        );

      }


      /*
       * Activate each stage when it reaches
       * the centre of the viewport.
       */

      steps.forEach(
        (step) => {

          ScrollTrigger.create({

            trigger:
              step,

            start:
              'top 58%',

            end:
              'bottom 58%',

            onEnter:
              () => {

                steps.forEach(
                  (item) =>
                    item.classList.remove(
                      'is-active'
                    )
                );

                step.classList.add(
                  'is-active'
                );

              },

            onEnterBack:
              () => {

                steps.forEach(
                  (item) =>
                    item.classList.remove(
                      'is-active'
                    )
                );

                step.classList.add(
                  'is-active'
                );

              }

          });

        }
      );

    }

  }

</script>
