  <!-- =====================================================
       CONTENT
  ====================================================== -->

  <div class="wrap relative z-[3] flex min-h-[85svh] flex-col justify-between py-12 md:py-16">


    <!-- TOP -->

    <div class="flex items-center justify-between">

      <div class="flex items-center gap-3">

        <span class="h-px w-8 bg-accent"></span>

        <span class="font-mono text-[9px] uppercase tracking-[.2em] text-paper/45">
          08 / Start a Project
        </span>

      </div>


      <span class="font-mono text-[9px] text-paper/30">
        PBJ INFRA
      </span>

    </div>


    <!-- =====================================================
         MAIN CTA
    ====================================================== -->

    <div class="cta-main max-w-[1100px]">

      <h2
        id="cta-title"
        class="cta-title font-serif text-[clamp(58px,10vw,145px)] leading-[.78] tracking-[-.065em]"
      >

        Have something
        <span class="block text-paper/35">
          worth building?
        </span>

      </h2>


      <p class="cta-copy mt-9 max-w-[520px] text-[14px] leading-[1.75] text-paper/55 md:text-[15px]">
        Tell us what you're planning. We'll help you understand the
        right way forward — from the first conversation to execution.
      </p>


      <!-- PRIMARY CTA -->

      <div class="mt-10">

        <a
          href="/contact/"
          class="cta-button group relative inline-flex items-center gap-7 overflow-hidden border border-paper/30 px-7 py-5 md:px-9 md:py-6"
          data-analytics-event="click_start_project"
          data-analytics-params={JSON.stringify({ placement: 'homepage_final_cta' })}
        >

          <span class="relative z-[2] font-mono text-[10px] uppercase tracking-[.18em]">
