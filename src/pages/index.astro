<script>

  const buildSection =
    document.querySelector<HTMLElement>(
      '.build-section'
    );


  if (buildSection) {

    const items =
      Array.from(
        buildSection.querySelectorAll<HTMLButtonElement>(
          '.build-item'
        )
      );


    const visuals =
      Array.from(
        buildSection.querySelectorAll<HTMLElement>(
          '.build-visual'
        )
      );


    const stageCategory =
      buildSection.querySelector<HTMLElement>(
        '#build-stage-category'
      );


    const stageTitle =
      buildSection.querySelector<HTMLElement>(
        '#build-stage-title'
      );


    const stageNumber =
      buildSection.querySelector<HTMLElement>(
        '.build-stage-label .font-mono:last-child'
      );


    const content = {

      aquatic: {
        category: 'Aquatic',
        title: 'Swimming Pools',
        number: '01 / 04'
      },

      hospitality: {
        category: 'Hospitality',
        title: 'Resorts & Destinations',
        number: '02 / 04'
      },

      recreation: {
        category: 'Recreation',
        title: 'Waterparks',
        number: '03 / 04'
      },

      specialized: {
        category: 'Specialized',
        title: 'Bespoke Structures',
        number: '04 / 04'
      }

    };


    const activate =
      (key: string) => {

        items.forEach(
          (item) => {

            const active =
              item.dataset.build === key;

            item.classList.toggle(
              'is-active',
              active
            );

            item.setAttribute(
              'aria-pressed',
              String(active)
            );

          }
        );


        visuals.forEach(
          (visual) => {

            visual.classList.toggle(
              'is-active',
              visual.dataset.visual === key
            );

          }
        );


        const data =
          content[key as keyof typeof content];

        if (!data) return;


        if (stageCategory) {

          stageCategory.textContent =
            data.category;

        }


        if (stageTitle) {

          stageTitle.textContent =
            data.title;

        }


        if (stageNumber) {

          stageNumber.textContent =
            data.number;

        }

      };


    items.forEach(
      (item) => {

        item.addEventListener(
          'mouseenter',
          () => {

            if (
              window.matchMedia(
                '(hover: hover)'
              ).matches
            ) {

              activate(
                item.dataset.build || 'aquatic'
              );

            }

          }
        );


        item.addEventListener(
          'focus',
          () => {

            activate(
              item.dataset.build || 'aquatic'
            );

          }
        );


        item.addEventListener(
          'click',
          () => {

            activate(
              item.dataset.build || 'aquatic'
            );

          }
        );

      }
    );

  }

</script>

