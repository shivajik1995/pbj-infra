---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageShell from '../../components/PageShell.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { whatsappLink } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.status === 'published');
  return projects.map((p) => ({ params: { slug: p.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const relatedService = await getEntry(d.relatedService);
const relatedLocation = d.relatedLocation ? await getEntry(d.relatedLocation) : null;
const relatedProjects = d.relatedProjects ? (await Promise.all(d.relatedProjects.map((r) => getEntry(r)))).filter(Boolean) : [];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Projects', url: '/projects/' },
  { name: d.name, url: `/projects/${entry.slug}/` },
];
const meta = [d.location, d.year].filter(Boolean).join(' · ');
---
<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  path={`/projects/${entry.slug}/`}
  ogImage={d.heroImage.src}
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    tone="ink"
    eyebrow={`Projects / ${d.projectType}`}
    metaRight={meta}
    title={d.name}
    lead={d.overview}
    bgImage={{ src: d.heroImage.src, alt: d.heroImage.alt }}
    ctas={[
      { label: 'Start a similar project', href: `/contact/?project=${relatedService?.slug ?? ''}`, style: 'solid', event: 'click_start_project', params: { placement: 'project_hero', project: entry.slug } },
    ]}
  />

  <section class="bg-paper spec-frame">
    <span class="cA"></span><span class="cB"></span>
    <img src={d.heroImage.src} alt={d.heroImage.alt} width={d.heroImage.width} height={d.heroImage.height} class="w-full max-h-[620px] object-cover" loading="lazy" decoding="async" />
  </section>

  <PageShell tone="paper">
    <div class="prose-content max-w-[74ch]" data-reveal>
      <Content />
    </div>
  </PageShell>

  {d.gallery.length > 0 && (
    <PageShell tone="paper-dim" labelledby="proj-gallery">
      <SectionHeader id="proj-gallery" num="02" label="Gallery" title="Project gallery" tone="paper" />
      <div class="mt-14 grid sm:grid-cols-2 gap-4" data-reveal-stagger>
        {d.gallery.map((img) => (
          <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover" />
        ))}
      </div>
    </PageShell>
  )}

  <PageShell tone="ink">
    <div class="grid md:grid-cols-2 gap-12" data-reveal>
      <div>
        <h2 class="font-serif text-2xl mb-4">Related service</h2>
        {relatedService && (
          <a href={relatedService.data.status === 'published' ? `/services/${relatedService.slug}/` : '/services/'} class="font-mono text-sm text-accent hover:underline">{relatedService.data.name} →</a>
        )}
        {relatedLocation && (
          <p class="mt-4">
            <a href={relatedLocation.data.status === 'published' ? `/locations/${relatedLocation.slug}/` : '/locations/'} class="font-mono text-sm text-accent hover:underline">See {relatedLocation.data.name} →</a>
          </p>
        )}
      </div>
      {relatedProjects.length > 0 && (
        <div>
          <h2 class="font-serif text-2xl mb-6">Related projects</h2>
          <div class="grid gap-5 sm:grid-cols-2">
            {relatedProjects.map((p) => p && (
              <ProjectCard name={p.data.name} projectType={p.data.projectType} location={p.data.location} href={p.data.status === 'published' ? `/projects/${p.slug}/` : null} image={p.data.heroImage} />
            ))}
          </div>
        </div>
      )}
    </div>
  </PageShell>

  <FinalCTA
    eyebrow="Start a project"
    title="Build something"
    titleMuted="similar?"
    copy={`Planning a project in the same scale as ${d.name}? Tell PBJ Infra what you have in mind.`}
    primary={{ label: 'Start your project', href: `/contact/?project=${relatedService?.slug ?? ''}`, event: 'click_start_project', params: { placement: 'project_cta', project: entry.slug } }}
    secondary={{ label: 'WhatsApp us', href: whatsappLink(`Hi PBJ Infra, I saw your ${d.name} project and would like to discuss something similar.`), external: true, event: 'click_whatsapp', params: { placement: 'project_cta', project: entry.slug } }}
  />
</BaseLayout>

<style>
  .prose-content :global(h2) { font-family: theme('fontFamily.serif'); font-size: clamp(24px, 2.8vw, 32px); margin: 2.2rem 0 0.75rem; letter-spacing: -0.02em; }
  .prose-content :global(h2:first-child) { margin-top: 0; }
  .prose-content :global(p) { color: theme('colors.ink-soft'); margin-bottom: 1rem; line-height: 1.75; }
  .prose-content :global(p em) { color: theme('colors.warn'); font-style: italic; }
  .prose-content :global(a) { color: theme('colors.accent'); text-decoration: underline; }
  .prose-content :global(strong) { color: theme('colors.ink'); }
</style>
