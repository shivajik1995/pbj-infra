---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import RevealScript from '../../components/RevealScript.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { whatsappLink } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.status === 'published');
  return projects.map((p) => ({ params: { slug: p.slug }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const relatedService = await getEntry(d.relatedService);
const relatedLocation = d.relatedLocation ? await getEntry(d.relatedLocation) : null;
const relatedProjects = d.relatedProjects ? (await Promise.all(d.relatedProjects.map((r) => getEntry(r)))).filter(Boolean) : [];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Projects', url: '/projects/' },
  { name: d.name, url: `/projects/${entry.slug}/` },
];
---
<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  path={`/projects/${entry.slug}/`}
  ogImage={d.heroImage.src}
  schema={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="wrap pt-8 pb-12">
    <div class="flex gap-2.5 flex-wrap mb-5">
      <span class="font-mono text-[10.5px] tracking-wide uppercase border border-ink/[.14] px-2.5 py-1.5 text-ink-soft">{d.projectType}</span>
      <span class="font-mono text-[10.5px] tracking-wide uppercase border border-ink/[.14] px-2.5 py-1.5 text-ink-soft">{d.location}</span>
      {d.year && <span class="font-mono text-[10.5px] tracking-wide uppercase border border-ink/[.14] px-2.5 py-1.5 text-ink-soft">{d.year}</span>}
    </div>
    <h1 class="text-[32px] md:text-[48px] max-w-[24ch]">{d.name}</h1>
  </section>

  <section class="spec-frame">
    <span class="cA"></span><span class="cB"></span>
    <img src={d.heroImage.src} alt={d.heroImage.alt} width={d.heroImage.width} height={d.heroImage.height} class="w-full max-h-[560px] object-cover" fetchpriority="high" />
  </section>

  <section class="wrap py-16 prose-content max-w-[74ch]">
    <Content />
  </section>

  {d.gallery.length > 0 && (
    <section class="wrap pb-16">
      <h2 class="font-serif text-2xl mb-6">Project gallery</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {d.gallery.map((img) => (
          <img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" class="w-full aspect-[4/3] object-cover" />
        ))}
      </div>
    </section>
  )}

  <section class="py-16 bg-paper-dim">
    <div class="wrap grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="font-serif text-2xl mb-4">Related service</h2>
        {relatedService && (
          <a href={relatedService.data.status === 'published' ? `/services/${relatedService.slug}/` : '/services/'} class="font-mono text-sm text-accent hover:underline">{relatedService.data.name} →</a>
        )}
        {relatedLocation && (
          <p class="mt-4">
            <a href={relatedLocation.data.status === 'published' ? `/locations/${relatedLocation.slug}/` : '/locations/'} class="font-mono text-sm text-accent hover:underline">See {relatedLocation.data.name} →</a>
          </p>
        )}
      </div>
      {relatedProjects.length > 0 && (
        <div>
          <h2 class="font-serif text-2xl mb-6">Related projects</h2>
          <div class="grid gap-5">
            {relatedProjects.map((p) => p && (
              <ProjectCard name={p.data.name} projectType={p.data.projectType} location={p.data.location} href={p.data.status === 'published' ? `/projects/${p.slug}/` : null} image={p.data.heroImage} />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="bg-ink text-paper py-20 text-center">
    <div class="wrap">
      <h2 class="font-serif text-3xl md:text-4xl">Build something similar?</h2>
      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href={`/contact/?project=${relatedService?.slug ?? ''}`} class="btn btn-solid" data-analytics-event="click_start_project" data-analytics-params={JSON.stringify({ placement: 'project_cta', project: entry.slug })}>Start Your Project →</a>
        <a href={whatsappLink(`Hi PBJ Infra, I saw your ${d.name} project and would like to discuss something similar.`)} target="_blank" rel="noopener" class="btn btn-lt" data-analytics-event="click_whatsapp" data-analytics-params={JSON.stringify({ placement: 'project_cta', project: entry.slug })}>WhatsApp Us →</a>
      </div>
    </div>
  </section>

  <RevealScript />
</BaseLayout>

<style>
  .prose-content :global(h2) { font-family: theme('fontFamily.serif'); font-size: 26px; margin: 1.75rem 0 0.75rem; }
  .prose-content :global(p) { color: theme('colors.ink-soft'); margin-bottom: 1rem; line-height: 1.7; }
  .prose-content :global(p em) { color: theme('colors.warn'); font-style: italic; }
  .prose-content :global(a) { color: theme('colors.accent'); text-decoration: underline; }
</style>
