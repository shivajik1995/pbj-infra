---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageShell from '../../components/PageShell.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { breadcrumbSchema } from '../../lib/schema';

const services = await getCollection('services');
const categories = ['Aquatic', 'Hospitality & Leisure', 'Residential', 'Specialized'] as const;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Services', url: '/services/' }];
const tones = ['paper', 'paper-dim', 'paper', 'paper-dim'] as const;
---
<BaseLayout
  title="Construction Services in Pune & Maharashtra | PBJ Infra"
  description="Every PBJ Infra construction service — swimming pools, filtration and tiling, waterparks, resorts, farmhouses, cob houses, ferrocement domes and land development."
  path="/services/"
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    tone="ink"
    eyebrow="Services / Capabilities"
    title="What PBJ Infra"
    titleMuted="builds."
    lead="Four disciplines, one in-house site team: aquatic construction, hospitality & leisure, residential builds, and specialised structural work. Every service is genuinely offered by PBJ Infra, operating since 2009 with a 5-year structural warranty."
    ctas={[
      { label: 'Start a project', href: '/contact/', style: 'solid', event: 'click_start_project', params: { placement: 'services_hero' } },
      { label: 'See projects', href: '/projects/', style: 'lt' },
    ]}
  />

  {categories.map((cat, i) => {
    const inCat = services.filter((s) => s.data.category === cat);
    const id = `svc-cat-${i}`;
    return (
      <PageShell tone={tones[i]} labelledby={id}>
        <SectionHeader id={id} num={String(i + 1).padStart(2, '0')} label="Discipline" title={cat} tone="paper" />
        <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal-stagger>
          {inCat.map((s) => (
            <ServiceCard
              name={s.data.name}
              category={s.data.category}
              shortDescription={s.data.shortDescription}
              href={s.data.status === 'published' ? `/services/${s.slug}/` : null}
              image={s.data.heroImage}
            />
          ))}
        </div>
      </PageShell>
    );
  })}

  <FinalCTA
    title="Not sure which"
    titleMuted="you need?"
    copy="Tell us what you're planning and PBJ Infra will help you understand the right way forward — from the first conversation to execution."
    primary={{ label: 'Start a project', href: '/contact/', event: 'click_start_project', params: { placement: 'services_cta' } }}
    contact={true}
  />
</BaseLayout>
