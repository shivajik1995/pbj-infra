
---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageShell from '../../components/PageShell.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { breadcrumbSchema } from '../../lib/schema';

const services = await getCollection(
  'services',
  ({ data }) => data.status === 'published'
);

const projects = (await getCollection(
  'projects',
  ({ data }) => data.status === 'published'
)).sort((a, b) => String(b.data.year || '').localeCompare(String(a.data.year || '')));

const featuredProjects = projects.slice(0, 3);

const categories = [
  'Aquatic',
  'Hospitality & Leisure',
  'Residential',
  'Specialized',
] as const;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
];

const tones = [
  'paper',
  'paper-dim',
  'paper',
  'paper-dim',
] as const;

const categoryDescriptions: Record<(typeof categories)[number], string> = {
  Aquatic:
    'Swimming pools, waterparks, filtration systems, waterproofing and complete aquatic construction for residential and commercial projects.',

  'Hospitality & Leisure':
    'Resorts, leisure spaces and destination-focused construction designed around experience, durability and long-term operation.',

  Residential:
    'Farmhouses, custom residences and alternative residential structures built with practical construction and site-specific thinking.',

  Specialized:
    'Ferrocement structures, domes, land development and other specialised construction requirements that need an unconventional approach.',
};

const categoryNumbers = categories.map((_, index) =>
  String(index + 1).padStart(2, '0')
);
---

<BaseLayout
  title="Construction Services in Pune & Maharashtra | PBJ Infra"
  description="PBJ Infra provides swimming pool, waterpark, resort, farmhouse and specialised construction services across Pune, Maharashtra and India."
  path="/services/"
  schema={[breadcrumbSchema(crumbs)]}
>
  <!-- ===================================================== -->
  <!-- HERO -->
  <!-- ===================================================== -->

  <PageHero
    crumbs={crumbs}
    tone="ink"
    eyebrow="Services / Capabilities"
    title="Construction expertise"
    titleMuted="built around you."
    lead="From aquatic environments and leisure spaces to residences and specialised structures, PBJ Infra brings design coordination, construction and site execution together under one experienced team."
    ctas={[
      {
        label: 'Start a project',
        href: '/contact/',
        style: 'solid',
        event: 'click_start_project',
        params: { placement: 'services_hero' },
      },
      {
        label: 'Explore projects',
        href: '/projects/',
        style: 'lt',
      },
    ]}
  />

  <!-- ===================================================== -->
  <!-- INTRO / CAPABILITY STATEMENT -->
  <!-- ===================================================== -->

  <section class="border-b border-black/10 bg-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 lg:grid-cols-[1fr_2fr] lg:px-8 lg:py-24">

      <div data-reveal>
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-[#1e6e64]">
          One construction partner
        </p>
      </div>

      <div data-reveal>
        <h2 class="max-w-4xl font-serif text-3xl leading-tight tracking-tight text-black sm:text-4xl lg:text-5xl">
          From the first site conversation
          <span class="text-black/35">to the finished structure.</span>
        </h2>

        <p class="mt-7 max-w-3xl text-base leading-8 text-black/60 sm:text-lg">
          PBJ Infra works across four complementary construction disciplines.
          Each project is approached according to its site, purpose, materials,
          systems and long-term use — rather than through a fixed template.
        </p>

        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 border-t border-black/10 pt-6">
          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-black/45">
            Operating since 2009
          </span>

          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-black/45">
            Pune → India
          </span>

          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-black/45">
            5-year structural warranty
          </span>
        </div>
      </div>

    </div>
  </section>

  <!-- ===================================================== -->
  <!-- SERVICE DISCIPLINES -->
  <!-- ===================================================== -->

  <main class="services-main">
    <div class="discipline-progress-line" aria-hidden="true">
      <span class="discipline-progress-fill"></span>
    </div>

    <div class="services-discipline-shell">
      <!-- ONE SHARED STICKY DISCIPLINE PANEL -->
      <aside class="discipline-panel" data-reveal aria-label="Service discipline">
        <div class="discipline-sticky">
          <div class="discipline-number-wrap">
            <span class="discipline-number" data-discipline-number>01</span>
            <span class="discipline-number-line"></span>
          </div>

          <div class="discipline-label">Discipline</div>
          <h2 class="discipline-title" data-discipline-title>Aquatic</h2>

          <p class="discipline-description" data-discipline-description>
            Swimming pools, waterparks, filtration systems, waterproofing and complete aquatic construction for residential and commercial projects.
          </p>

          <div class="discipline-meta">
            <span class="discipline-meta-line"></span>
            <span><strong data-discipline-count>0</strong> services</span>
          </div>

          <div class="discipline-scroll-indicator">
            <div class="discipline-scroll-track"><span></span></div>
            <span class="discipline-scroll-text">Scroll to explore</span>
          </div>
        </div>
      </aside>

      <!-- ALL SERVICE CARDS SCROLL ON THE RIGHT -->
      <div class="service-categories-column">
        {categories.map((category, index) => {
          const inCategory = services.filter(
            (service) => service.data.category === category
          );
          const sectionId = `service-category-${index}`;

          return (
            <section
              class="service-discipline-section"
              data-discipline-section
              data-index={index}
              data-number={categoryNumbers[index]}
              data-title={category}
              data-description={categoryDescriptions[category]}
              data-count={inCategory.length}
              aria-labelledby={sectionId}
            >
              <PageShell tone={tones[index]} labelledby={sectionId}>
                <div class="service-cards-column">
                  <div class="discipline-mobile-heading">
                    <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-[#1e6e64]">
                      {categoryNumbers[index]} · Discipline
                    </span>
                    <h2 id={sectionId} class="mt-3 font-serif text-3xl tracking-tight sm:text-4xl">
                      {category}
                    </h2>
                    <p class="mt-4 max-w-xl text-sm leading-7 text-black/55">
                      {categoryDescriptions[category]}
                    </p>
                  </div>

                  {inCategory.length > 0 ? (
                    <div class="service-cards-stack" data-reveal-stagger>
                      {inCategory.map((service, serviceIndex) => (
                        <article
                          class="service-rectangle"
                          data-service-card
                          style={`--card-index:${serviceIndex};`}
                        >
                          <div class="service-rectangle-number">
                            {String(serviceIndex + 1).padStart(2, '0')}
                          </div>

                          <div class="service-rectangle-image">
                            {service.data.heroImage && (
                              <img
                                src={service.data.heroImage.src}
                                alt={service.data.heroImage.alt}
                                width={service.data.heroImage.width}
                                height={service.data.heroImage.height}
                                loading="lazy"
                                decoding="async"
                              />
                            )}
                            <div class="service-image-overlay"></div>
                          </div>

                          <div class="service-rectangle-content">
                            <div>
                              <p class="service-card-category">{service.data.category}</p>
                              <h3 class="service-card-title">{service.data.name}</h3>
                              <p class="service-card-description">
                                {service.data.shortDescription}
                              </p>
                            </div>

                            {service.data.status === 'published' && (
                              <a
                                href={`/services/${service.slug}/`}
                                class="service-card-arrow"
                                aria-label={`Explore ${service.data.name}`}
                              >
                                <span>Explore</span>
                                <span class="arrow">→</span>
                              </a>
                            )}
                          </div>
                        </article>
                      ))}
                    </div>
                  ) : (
                    <div class="border border-dashed border-black/15 p-8">
                      <p class="font-mono text-xs uppercase tracking-[0.16em] text-black/40">
                        Services coming soon
                      </p>
                    </div>
                  )}
                </div>
              </PageShell>
            </section>
          );
        })}
      </div>
    </div>
  </main>

  <!-- ===================================================== -->
  <!-- SERVICE PROCESS -->
  <!-- ===================================================== -->

  <section class="bg-[#111] text-white">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">

      <div class="process-layout">

        <!-- FIXED / STICKY PROCESS INTRO -->
        <aside class="process-panel" data-reveal aria-label="How we work">
          <div class="process-sticky">
            <div class="process-number-wrap">
              <span class="process-number">01</span>
              <span class="process-number-line"></span>
            </div>

            <p class="process-label">How we work</p>

            <h2 class="process-title">
              Construction is more than
              <span class="heading-accent">putting things together.</span>
            </h2>

            <p class="process-intro">
              A clear process keeps design, construction and site execution moving
              together from the first conversation to completion.
            </p>

            <div class="process-meta">
              <span class="process-meta-line"></span>
              <span>4 steps</span>
            </div>

            <div class="process-scroll-indicator">
              <div class="process-scroll-track"><span></span></div>
              <span>Scroll to explore</span>
            </div>
          </div>
        </aside>

        <!-- SCROLLING PROCESS STEPS -->
        <div class="process-steps">

          <div
            class="process-row grid gap-5 border-b border-white/10 py-10 sm:grid-cols-[80px_1fr]"
            data-reveal
          >
            <span class="font-mono text-xs text-[#1e6e64]">
              01
            </span>

            <div>
              <h3 class="font-serif text-2xl">
                Understand
              </h3>

              <p class="mt-3 max-w-2xl text-sm leading-7 text-white/50">
                We begin with the site, requirements, intended use and practical
                constraints of the project.
              </p>
            </div>
          </div>

          <div
            class="process-row grid gap-5 border-b border-white/10 py-10 sm:grid-cols-[80px_1fr]"
            data-reveal
          >
            <span class="font-mono text-xs text-[#1e6e64]">
              02
            </span>

            <div>
              <h3 class="font-serif text-2xl">
                Coordinate
              </h3>

              <p class="mt-3 max-w-2xl text-sm leading-7 text-white/50">
                Structure, finishes, systems and specialist requirements are
                considered together before execution.
              </p>
            </div>
          </div>

          <div
            class="process-row grid gap-5 border-b border-white/10 py-10 sm:grid-cols-[80px_1fr]"
            data-reveal
          >
            <span class="font-mono text-xs text-[#1e6e64]">
              03
            </span>

            <div>
              <h3 class="font-serif text-2xl">
                Build
              </h3>

              <p class="mt-3 max-w-2xl text-sm leading-7 text-white/50">
                Our site team takes the project through construction, coordination,
                finishing and practical completion.
              </p>
            </div>
          </div>

          <div
            class="process-row grid gap-5 py-10 sm:grid-cols-[80px_1fr]"
            data-reveal
          >
            <span class="font-mono text-xs text-[#1e6e64]">
              04
            </span>

            <div>
              <h3 class="font-serif text-2xl">
                Deliver
              </h3>

              <p class="mt-3 max-w-2xl text-sm leading-7 text-white/50">
                The objective is a completed space that works as intended,
                looks considered and is ready for long-term use.
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- PROJECT PROOF -->
  <!-- ===================================================== -->

  <section class="project-showcase" aria-labelledby="project-showcase-title">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">

      <div class="project-showcase-header" data-reveal>
        <div>
          <div class="project-showcase-kicker">
            <span class="project-showcase-line"></span>
            <span>Built examples</span>
          </div>

          <h2 id="project-showcase-title" class="project-showcase-title">
            See the work
            <span class="heading-accent">that brings it together.</span>
          </h2>
        </div>

        <a href="/projects/" class="project-showcase-link">
          <span>View all projects</span>
          <span class="project-showcase-link-arrow">↗</span>
        </a>
      </div>

      {featuredProjects.length > 0 ? (
        <div class="project-horizontal-showcase" data-project-showcase>
          <div class="project-horizontal-topline">
            <span class="project-horizontal-hint">Drag / scroll to explore</span>
            <span class="project-horizontal-counter"><strong data-project-current>01</strong> / {String(featuredProjects.length).padStart(2, '0')}</span>
          </div>

          <div class="project-horizontal-track" data-project-track tabindex="0" aria-label="Featured projects">
            {featuredProjects.map((project, index) => (
              <a
                href={`/projects/${project.slug}/`}
                class="project-horizontal-card"
                data-project-card
              >
                <div class="project-horizontal-image">
                  <img
                    src={project.data.heroImage.src}
                    alt={project.data.heroImage.alt}
                    width={project.data.heroImage.width}
                    height={project.data.heroImage.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="project-horizontal-image-shade"></div>
                  <span class="project-horizontal-number">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </div>

                <div class="project-horizontal-content">
                  <div class="project-horizontal-topline-inner">
                    <span>{project.data.projectType}</span>
                    <span>{project.data.year}</span>
                  </div>

                  <h3 class="project-horizontal-title">
                    {project.data.name}
                  </h3>

                  <div class="project-horizontal-meta">
                    <span>{project.data.location}</span>
                  </div>

                  <div class="project-horizontal-action">
                    <span>View project</span>
                    <span>↗</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <div class="project-horizontal-progress" aria-hidden="true">
            <span data-project-progress></span>
          </div>
        </div>
      ) : (
        <div class="project-showcase-empty">
          <p>No published projects yet.</p>
        </div>
      )}

      <div class="project-showcase-footer" data-reveal>
        <div>
          <span class="project-showcase-footer-number">{projects.length}</span>
          <span>published projects</span>
        </div>

        <p>
          Aquatic environments, leisure destinations, residences and specialised
          structures — delivered with the same attention to site and detail.
        </p>

        <a href="/projects/" class="project-showcase-footer-link">
          Explore portfolio <span>→</span>
        </a>
      </div>

    </div>
  </section>

  <!-- ===================================================== -->
  <!-- FINAL CTA -->
  <!-- ===================================================== -->

  <FinalCTA
    title="Not sure which"
    titleMuted="service you need?"
    copy="Tell us what you're planning, where you're building and what you want the finished space to achieve. PBJ Infra will help you understand the right way forward."
    primary={{
      label: 'Start a project',
      href: '/contact/',
      event: 'click_start_project',
      params: { placement: 'services_cta' },
    }}
    contact={true}
  />

</BaseLayout>

<script>
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('[data-discipline-section]')
  );

  const numberEl = document.querySelector<HTMLElement>('[data-discipline-number]');
  const titleEl = document.querySelector<HTMLElement>('[data-discipline-title]');
  const descriptionEl = document.querySelector<HTMLElement>('[data-discipline-description]');
  const countEl = document.querySelector<HTMLElement>('[data-discipline-count]');
  const progressFill = document.querySelector<HTMLElement>('.discipline-progress-fill');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let activeIndex = -1;
  let ticking = false;

  const setActive = (section: HTMLElement) => {
    const index = Number(section.dataset.index || 0);
    if (index === activeIndex) return;
    activeIndex = index;

    if (numberEl) numberEl.textContent = section.dataset.number || '01';
    if (titleEl) titleEl.textContent = section.dataset.title || '';
    if (descriptionEl) descriptionEl.textContent = section.dataset.description || '';
    if (countEl) countEl.textContent = section.dataset.count || '0';

    sections.forEach((item, i) => item.classList.toggle('is-active', i === index));

    if (!reduceMotion) {
      [numberEl, titleEl, descriptionEl, countEl].forEach((el) => {
        if (!el) return;
        el.animate(
          [
            { opacity: 0.25, transform: 'translateY(6px)' },
            { opacity: 1, transform: 'translateY(0)' },
          ],
          { duration: 320, easing: 'cubic-bezier(.2,.65,.25,1)' }
        );
      });
    }
  };

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

        if (visible.length) {
          setActive(visible[0].target as HTMLElement);
        }
      },
      {
        threshold: [0.05, 0.2, 0.5],
        rootMargin: '-22% 0px -58% 0px',
      }
    );

    sections.forEach((section) => observer.observe(section));
    setActive(sections[0]);
  }

  const projectTrack = document.querySelector<HTMLElement>('[data-project-track]');
  const projectCards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-project-card]')
  );
  const projectCurrent = document.querySelector<HTMLElement>('[data-project-current]');
  const projectProgress = document.querySelector<HTMLElement>('[data-project-progress]');

  const updateProjectScroll = () => {
    if (!projectTrack || !projectCards.length) return;

    const maxScroll = projectTrack.scrollWidth - projectTrack.clientWidth;
    const progress = maxScroll > 0 ? projectTrack.scrollLeft / maxScroll : 0;
    if (projectProgress) projectProgress.style.width = `${Math.min(100, Math.max(0, progress * 100))}%`;

    const trackRect = projectTrack.getBoundingClientRect();
    const trackCenter = trackRect.left + trackRect.width * .28;
    let closestIndex = 0;
    let closestDistance = Infinity;

    projectCards.forEach((card, index) => {
      const rect = card.getBoundingClientRect();
      const distance = Math.abs((rect.left + rect.width * .18) - trackCenter);
      if (distance < closestDistance) {
        closestDistance = distance;
        closestIndex = index;
      }
    });

    if (projectCurrent) {
      projectCurrent.textContent = String(closestIndex + 1).padStart(2, '0');
    }
  };

  projectTrack?.addEventListener('scroll', updateProjectScroll, { passive: true });
  projectTrack?.addEventListener('wheel', (event) => {
    if (!projectTrack || Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
    const maxScroll = projectTrack.scrollWidth - projectTrack.clientWidth;
    const atStart = projectTrack.scrollLeft <= 0;
    const atEnd = projectTrack.scrollLeft >= maxScroll - 1;

    if (maxScroll > 0 && ((event.deltaY < 0 && !atStart) || (event.deltaY > 0 && !atEnd))) {
      event.preventDefault();
      projectTrack.scrollLeft += event.deltaY;
    }
  }, { passive: false });

  projectTrack?.addEventListener('keydown', (event) => {
    if (!projectTrack) return;
    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
      event.preventDefault();
      projectTrack.scrollBy({
        left: event.key === 'ArrowRight' ? projectTrack.clientWidth * .72 : -projectTrack.clientWidth * .72,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    }
  });

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-service-card]')
  );

  const updateScrollEffects = () => {
    const scrollTop = window.scrollY;
    const documentHeight = document.documentElement.scrollHeight - window.innerHeight;

    if (progressFill && documentHeight > 0) {
      progressFill.style.height = `${Math.min(100, Math.max(0, (scrollTop / documentHeight) * 100))}%`;
    }

    if (!reduceMotion) {
      const viewportHeight = window.innerHeight;
      cards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > viewportHeight) return;
        const center = rect.top + rect.height / 2;
        const distance = (center - viewportHeight / 2) / viewportHeight;
        const shift = Math.max(-6, Math.min(6, distance * -7));
        card.style.setProperty('--card-shift', `${shift}px`);
      });
    }

    ticking = false;
  };

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(updateScrollEffects);
      ticking = true;
    }
  }, { passive: true });

  window.addEventListener('resize', updateScrollEffects, { passive: true });
  updateScrollEffects();
  updateProjectScroll();
</script>

<style>
  .services-main {
    position: relative;
  }

  .service-discipline-section {
    position: relative;
    border-bottom: 1px solid rgba(17, 17, 17, 0.08);
  }

  .services-discipline-shell {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .discipline-panel {
    min-width: 0;
    align-self: stretch;
    padding-left: 3.25rem;
  }

  .discipline-sticky {
    position: sticky;
    top: 7rem;
    padding: 4rem 0 5rem;
  }

  .discipline-number-wrap {
    display: flex;
    align-items: center;
    gap: .9rem;
    margin-bottom: 1rem;
    overflow: hidden;
  }

  .discipline-number {
    font-family: theme('fontFamily.mono');
    font-size: 11px;
    line-height: 1;
    letter-spacing: .18em;
    color: #1e6e64;
  }

  .discipline-number-line {
    width: 60px;
    height: 1px;
    background: #1e6e64;
  }

  .discipline-label {
    font-family: theme('fontFamily.mono');
    font-size: 10px;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: .2em;
    color: rgba(0,0,0,.4);
  }

  .discipline-title {
    margin-top: .7rem;
    font-family: theme('fontFamily.serif');
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    line-height: 1;
    letter-spacing: -.035em;
    color: #111;
  }

  .discipline-description {
    max-width: 270px;
    margin-top: 1.5rem;
    font-size: .875rem;
    line-height: 1.8;
    color: rgba(0,0,0,.55);
  }

  .discipline-meta {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-top: 1.75rem;
    font-family: theme('fontFamily.mono');
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .16em;
    color: rgba(0,0,0,.4);
  }

  .discipline-meta strong {
    color: #111;
    font-weight: 600;
  }

  .discipline-meta-line {
    width: 30px;
    height: 1px;
    background: #1e6e64;
  }

  .discipline-scroll-indicator {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-top: 3rem;
  }

  .discipline-scroll-track {
    position: relative;
    width: 34px;
    height: 1px;
    overflow: hidden;
    background: rgba(0,0,0,.15);
  }

  .discipline-scroll-track span {
    display: block;
    width: 14px;
    height: 1px;
    background: #1e6e64;
    animation: discipline-pulse 1.8s ease-in-out infinite;
