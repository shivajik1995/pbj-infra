---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageShell from '../../components/PageShell.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { breadcrumbSchema, serviceSchema, faqSchema } from '../../lib/schema';
import { whatsappLink } from '../../lib/site';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => data.status === 'published');
  return services.map((s) => ({ params: { slug: s.slug }, props: { entry: s } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const relatedServices = d.relatedServices ? await Promise.all(d.relatedServices.map((r) => getEntry(r))) : [];
const relatedProjects = d.relatedProjects ? await Promise.all(d.relatedProjects.map((r) => getEntry(r))) : [];
const faqs = d.faq ? (await Promise.all(d.faq.map((r) => getEntry(r)))).map((f) => f!.data) : [];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: d.name, url: `/services/${entry.slug}/` },
];
const svc = d.name.toLowerCase();
---
<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  path={`/services/${entry.slug}/`}
  ogImage={d.heroImage.src}
  schema={[
    breadcrumbSchema(crumbs),
    serviceSchema({ name: d.name, description: d.shortDescription, url: `/services/${entry.slug}/`, solutions: d.solutions }),
    ...(faqs.length ? [faqSchema(faqs)] : []),
  ]}
>
  <PageHero
    crumbs={crumbs}
    tone="ink"
    eyebrow={`Services / ${d.category}`}
    title={d.h1 ?? `${d.name} in Pune & Maharashtra`}
    lead={d.shortDescription}
    bgImage={{ src: d.heroImage.src, alt: d.heroImage.alt }}
    ctas={[
      { label: d.ctaLabel, href: `/contact/?project=${entry.slug}`, style: 'solid', event: 'click_start_project', params: { placement: 'service_hero', service: entry.slug } },
      { label: 'View projects', href: '/projects/', style: 'lt' },
    ]}
  />

  <!-- OVERVIEW (markdown body) -->
  <PageShell tone="paper">
    <div class="prose-content max-w-[74ch]" data-reveal>
      <Content />
    </div>
  </PageShell>

  <!-- SOLUTIONS -->
  <PageShell tone="paper-dim" labelledby="svc-solutions">
    <SectionHeader id="svc-solutions" num="02" label="Scope" title={`What ${svc} covers`} tone="paper" />
    <div class="mt-14 grid gap-6 sm:grid-cols-2" data-reveal-stagger>
      {d.solutions.map((sol) => (
        <div class="border-l-2 border-accent pl-5 py-1">
          <h3 class="font-serif text-lg mb-1.5">{sol.name}</h3>
          <p class="text-[14px] text-ink-soft">{sol.description}</p>
        </div>
      ))}
    </div>
  </PageShell>

  <!-- WHY PBJ -->
  <PageShell tone="paper" labelledby="svc-why">
    <SectionHeader id="svc-why" num="03" label="Advantage" title={`Why PBJ for ${svc}`} tone="paper" />
    <ul class="mt-14 grid gap-5 sm:grid-cols-2" data-reveal-stagger>
      {d.whyPbj.map((w) => (
        <li class="flex gap-3 text-[14.5px] text-ink-soft"><span class="text-accent font-mono">—</span>{w}</li>
      ))}
    </ul>
  </PageShell>

  <!-- PROCESS -->
  <PageShell tone="ink" labelledby="svc-process">
    <SectionHeader id="svc-process" num="04" label="Process" title={`How PBJ delivers ${svc}`} tone="ink" />
    <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-paper/[.18] border border-paper/[.18]" data-reveal>
      {d.process.map((step, i) => (
        <div class="bg-ink p-6">
          <span class="font-mono text-accent text-sm">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="font-serif text-lg mt-3 mb-2">{step.step}</h3>
          <p class="text-[13.5px] text-paper/65">{step.description}</p>
        </div>
      ))}
    </div>
  </PageShell>

  {faqs.length > 0 && (
    <PageShell tone="paper" labelledby="svc-faq">
      <SectionHeader id="svc-faq" num="05" label="Common questions" title="FAQ" tone="paper" />
      <div class="mt-12 max-w-[880px]" data-reveal>
        <FAQAccordion items={faqs} idPrefix={`svc-${entry.slug}`} />
      </div>
    </PageShell>
  )}

  {(relatedServices.length > 0 || relatedProjects.length > 0) && (
    <PageShell tone="paper-dim">
      <div class="grid md:grid-cols-2 gap-12" data-reveal>
        {relatedServices.length > 0 && (
          <div>
            <h2 class="font-serif text-2xl mb-6">Related services</h2>
            <ul class="flex flex-col gap-3">
              {relatedServices.map((s) => s && (
                <li><a href={s.data.status === 'published' ? `/services/${s.slug}/` : '/services/'} class="font-mono text-sm text-accent hover:underline">{s.data.name} →</a></li>
              ))}
            </ul>
          </div>
        )}
        {relatedProjects.length > 0 && (
          <div>
            <h2 class="font-serif text-2xl mb-6">Related projects</h2>
            <div class="grid gap-5">
              {relatedProjects.map((p) => p && (
                <ProjectCard
                  name={p.data.name}
                  projectType={p.data.projectType}
                  location={p.data.location}
                  href={p.data.status === 'published' ? `/projects/${p.slug}/` : null}
                  image={p.data.heroImage}
                />
              ))}
            </div>
          </div>
        )}
      </div>
    </PageShell>
  )}

  <FinalCTA
    eyebrow="Start a project"
    title={`Planning a ${svc} project`}
    titleMuted="in Pune, Latur or elsewhere in Maharashtra?"
    primary={{ label: d.ctaLabel, href: `/contact/?project=${entry.slug}`, event: 'click_start_project', params: { placement: 'service_cta', service: entry.slug } }}
    secondary={{ label: 'WhatsApp us', href: whatsappLink(d.whatsappMessage), external: true, event: 'click_whatsapp', params: { placement: 'service_cta', service: entry.slug } }}
  />
</BaseLayout>

<style>
  .prose-content :global(h2) { font-family: theme('fontFamily.serif'); font-size: clamp(26px, 3vw, 34px); margin: 2.4rem 0 1rem; letter-spacing: -0.02em; }
  .prose-content :global(h2:first-child) { margin-top: 0; }
  .prose-content :global(p) { color: theme('colors.ink-soft'); margin-bottom: 1rem; line-height: 1.75; }
  .prose-content :global(ul) { margin: 0 0 1.25rem 1.1rem; list-style: disc; color: theme('colors.ink-soft'); }
  .prose-content :global(li) { margin-bottom: 0.4rem; line-height: 1.7; }
  .prose-content :global(a) { color: theme('colors.accent'); text-decoration: underline; }
  .prose-content :global(strong) { color: theme('colors.ink'); }
  .prose-content :global(em) { color: theme('colors.warn'); font-style: italic; }
</style>
