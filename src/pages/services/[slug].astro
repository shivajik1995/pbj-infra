---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import RevealScript from '../../components/RevealScript.astro';
import { breadcrumbSchema, serviceSchema, faqSchema } from '../../lib/schema';
import { whatsappLink } from '../../lib/site';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => data.status === 'published');
  return services.map((s) => ({ params: { slug: s.slug }, props: { entry: s } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const relatedServices = d.relatedServices ? await Promise.all(d.relatedServices.map((r) => getEntry(r))) : [];
const relatedProjects = d.relatedProjects ? await Promise.all(d.relatedProjects.map((r) => getEntry(r))) : [];
const faqs = d.faq ? (await Promise.all(d.faq.map((r) => getEntry(r)))).map((f) => f!.data) : [];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: d.name, url: `/services/${entry.slug}/` },
];
---
<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  path={`/services/${entry.slug}/`}
  ogImage={d.heroImage.src}
  schema={[
    breadcrumbSchema(crumbs),
    serviceSchema({ name: d.name, description: d.shortDescription, url: `/services/${entry.slug}/` }),
    ...(faqs.length ? [faqSchema(faqs)] : []),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <!-- HERO -->
  <section class="wrap pt-8 pb-16 grid md:grid-cols-2 gap-12 items-center">
    <div>
      <span class="font-mono text-[11px] text-accent tracking-wide uppercase">{d.category}</span>
      <h1 class="text-[32px] md:text-[46px] leading-tight mt-3">{d.name} Company in Pune &amp; Maharashtra</h1>
      <p class="mt-5 text-ink-soft max-w-[52ch]">{d.shortDescription}</p>
      <div class="flex gap-4 flex-wrap mt-8">
        <a href={`/contact/?project=${entry.slug}`} class="btn btn-solid" data-analytics-event="click_start_project" data-analytics-params={JSON.stringify({ placement: 'service_hero', service: entry.slug })}>{d.ctaLabel} →</a>
        <a href="/projects/" class="btn btn-line">View Projects →</a>
      </div>
    </div>
    <div class="spec-frame aspect-[4/5]">
      <span class="cA"></span><span class="cB"></span>
      <img src={d.heroImage.src} alt={d.heroImage.alt} width={d.heroImage.width} height={d.heroImage.height} class="w-full h-full object-cover" fetchpriority="high" />
    </div>
  </section>

  <!-- OVERVIEW (markdown body) -->
  <section class="wrap pb-16 prose-content max-w-[74ch]">
    <Content />
  </section>

  <!-- SOLUTIONS -->
  <section class="py-16 bg-paper-dim">
    <div class="wrap">
      <h2 class="font-serif text-3xl mb-8">Types of {d.name.toLowerCase()} PBJ builds</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {d.solutions.map((sol) => (
          <div class="border-l-2 border-accent pl-5 py-1">
            <h3 class="font-serif text-lg mb-1.5">{sol.name}</h3>
            <p class="text-[14px] text-ink-soft">{sol.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY PBJ -->
  <section class="wrap py-16">
    <h2 class="font-serif text-3xl mb-8">Why PBJ for {d.name.toLowerCase()}</h2>
    <ul class="grid sm:grid-cols-2 gap-5">
      {d.whyPbj.map((w) => (
        <li class="flex gap-3 text-[14.5px] text-ink-soft"><span class="text-accent font-mono">—</span>{w}</li>
      ))}
    </ul>
  </section>

  <!-- PROCESS -->
  <section class="py-16 bg-ink text-paper">
    <div class="wrap">
      <h2 class="font-serif text-3xl mb-8">How a {d.name.toLowerCase()} project runs</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-paper/[.18] border border-paper/[.18]">
        {d.process.map((step, i) => (
          <div class="bg-ink p-6">
            <span class="font-mono text-accent text-sm">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-serif text-lg mt-3 mb-2">{step.step}</h3>
            <p class="text-[13.5px] text-paper/65">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="wrap py-16 max-w-[880px]">
      <h2 class="font-serif text-3xl mb-4">FAQ</h2>
      <FAQAccordion items={faqs} idPrefix={`svc-${entry.slug}`} />
    </section>
  )}

  {(relatedServices.length > 0 || relatedProjects.length > 0) && (
    <section class="py-16 bg-paper-dim">
      <div class="wrap grid md:grid-cols-2 gap-12">
        {relatedServices.length > 0 && (
          <div>
            <h2 class="font-serif text-2xl mb-6">Related services</h2>
            <ul class="flex flex-col gap-3">
              {relatedServices.map((s) => s && (
                <li><a href={s.data.status === 'published' ? `/services/${s.slug}/` : '/services/'} class="font-mono text-sm text-accent hover:underline">{s.data.name} →</a></li>
              ))}
            </ul>
          </div>
        )}
        {relatedProjects.length > 0 && (
          <div>
            <h2 class="font-serif text-2xl mb-6">Related projects</h2>
            <div class="grid gap-5">
              {relatedProjects.map((p) => p && (
                <ProjectCard
                  name={p.data.name}
                  projectType={p.data.projectType}
                  location={p.data.location}
                  href={p.data.status === 'published' ? `/projects/${p.slug}/` : null}
                  image={p.data.heroImage}
                />
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-ink text-paper py-20 text-center">
    <div class="wrap">
      <h2 class="font-serif text-3xl md:text-4xl">Planning a {d.name.toLowerCase()} project?</h2>
      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href={`/contact/?project=${entry.slug}`} class="btn btn-solid" data-analytics-event="click_start_project" data-analytics-params={JSON.stringify({ placement: 'service_cta', service: entry.slug })}>{d.ctaLabel} →</a>
        <a href={whatsappLink(d.whatsappMessage)} target="_blank" rel="noopener" class="btn btn-lt" data-analytics-event="click_whatsapp" data-analytics-params={JSON.stringify({ placement: 'service_cta', service: entry.slug })}>WhatsApp Us →</a>
      </div>
    </div>
  </section>

  <RevealScript />
</BaseLayout>

<style>
  .prose-content :global(h2) { font-family: theme('fontFamily.serif'); font-size: 28px; margin: 2rem 0 1rem; }
  .prose-content :global(p) { color: theme('colors.ink-soft'); margin-bottom: 1rem; line-height: 1.7; }
  .prose-content :global(a) { color: theme('colors.accent'); text-decoration: underline; }
</style>
