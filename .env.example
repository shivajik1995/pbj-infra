# Copy to .env for local dev. In production, set these as real environment
# variables / secrets on the host — never commit .env, never ship these to
# the client bundle. Only PUBLIC_-prefixed vars are ever exposed to the browser.

# ── Google Reviews (Google Business Profile / Places API) ──────────────────
# Used only at BUILD TIME (src/lib/googleReviews.ts) to fetch the current
# rating, review count and a handful of reviews for pbjinfra.com's Google
# Business Profile. Never called from the browser. If unset, the site
# renders the "Integration Pending" placeholder honestly instead of a
# fabricated rating — see docs/technical-seo-plan.md.
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=

# ── Lead form backend (src/pages/api/lead.ts) ───────────────────────────────
# Pick ONE notification path and configure it; the handler no-ops (logs only)
# if neither is set, so the form still works end-to-end in dev without
# secrets, it just won't deliver anywhere.
LEAD_NOTIFY_EMAIL=
RESEND_API_KEY=

# Optional spam protection (Cloudflare Turnstile). If unset, the honeypot +
# time-trap heuristics in LeadForm.astro are the only spam defense.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics ────────────────────────────────────────────────────────────
# GA4 Measurement ID. If unset, analytics.ts no-ops (events are still
# dispatched as DOM CustomEvents for any future listener, just not sent to GA).
PUBLIC_GA_MEASUREMENT_ID=
